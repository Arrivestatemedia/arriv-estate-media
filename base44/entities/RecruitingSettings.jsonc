{
  "name": "RecruitingSettings",
  "type": "object",
  "properties": {
    "recruiting_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Master toggle for the recruiting module"
    },
    "max_search_results": {
      "type": "integer",
      "default": 10,
      "description": "Maximum prospects returned per search"
    },
    "outreach_approval_required": {
      "type": "boolean",
      "default": true,
      "description": "Whether outreach messages require admin approval before sending"
    },
    "opt_out_language": {
      "type": "string",
      "default": "Reply STOP to opt out at any time.",
      "description": "Opt-out language appended to outreach messages"
    },
    "default_radius_miles": {
      "type": "number",
      "default": 25
    },
    "search_frequency_days": {
      "type": "integer",
      "default": 7,
      "description": "Minimum days between continuous recruiting cycles"
    },
    "max_prospects_per_cycle": {
      "type": "integer",
      "default": 15,
      "description": "Cap on new prospects per continuous recruiting cycle"
    },
    "company_name": {
      "type": "string",
      "default": "Arriv Estate Media"
    },
    "default_sales_title": {
      "type": "string",
      "default": "Sales Growth Advisor"
    }
  },
  "required": []
}