{
  "name": "RecruitingSettings",
  "type": "object",
  "properties": {
    "recruiting_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Master toggle for the recruiting module"
    },
    "max_search_results": {
      "type": "number",
      "default": 25,
      "description": "Maximum prospects returned per search"
    },
    "outreach_approval_required": {
      "type": "boolean",
      "default": true,
      "description": "Whether outreach messages require admin approval before sending"
    },
    "opt_out_language": {
      "type": "string",
      "description": "Opt-out language appended to outreach messages"
    },
    "default_search_radius": {
      "type": "number",
      "default": 50,
      "description": "Default search radius in miles"
    },
    "continuous_recruiting_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether continuous auto-sourcing is enabled"
    }
  },
  "required": []
}