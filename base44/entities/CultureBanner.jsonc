{
  "name": "CultureBanner",
  "type": "object",
  "properties": {
    "message": {
      "type": "string",
      "description": "Motivational message text displayed to reps"
    },
    "verse_reference": {
      "type": "string",
      "description": "Bible verse reference (e.g. Acts 28:19)"
    },
    "verse_text": {
      "type": "string",
      "description": "Full text of the Bible verse"
    },
    "auto_generated": {
      "type": "boolean",
      "default": false,
      "description": "Whether this banner was generated by AI automation"
    },
    "generated_date": {
      "type": "string",
      "format": "date",
      "description": "Date this AI banner was generated (for daily dedup)"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "display_order": {
      "type": "integer",
      "default": 0,
      "description": "Sort order for rotation"
    },
    "created_by": {
      "type": "string"
    }
  },
  "required": [
    "message"
  ]
}