{
  "name": "HireCandidate",
  "type": "object",
  "properties": {
    "job_id": {
      "type": "string",
      "description": "HireJob ID this candidate applied to"
    },
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "location": {
      "type": "string",
      "description": "Candidate location/address (synced from JobApplication)"
    },
    "dob": {
      "type": "string",
      "format": "date",
      "description": "Candidate date of birth (synced from JobApplication for age display)"
    },
    "source": {
      "type": "string",
      "enum": [
        "company_career_page",
        "linkedin",
        "indeed",
        "employee_referral",
        "recruiter",
        "other"
      ],
      "default": "company_career_page",
      "description": "Where the candidate was sourced from"
    },
    "resume_url": {
      "type": "string",
      "description": "Uploaded resume file URL"
    },
    "resume_text": {
      "type": "string",
      "description": "Raw or pasted resume text"
    },
    "cover_letter": {
      "type": "string"
    },
    "resume_analysis": {
      "type": "object",
      "description": "AI resume analysis result"
    },
    "evaluation": {
      "type": "object",
      "description": "AI candidate evaluation result"
    },
    "status": {
      "type": "string",
      "enum": [
        "applied",
        "screening",
        "interviewing",
        "advanced",
        "hold",
        "offer",
        "declined",
        "hired"
      ],
      "default": "applied"
    },
    "interview_notes": {
      "type": "string",
      "description": "General interview notes"
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Additional uploaded documents"
    },
    "decision": {
      "type": "string",
      "enum": [
        "pending",
        "advance",
        "hold",
        "another_interview",
        "offer",
        "decline"
      ],
      "default": "pending"
    },
    "decision_notes": {
      "type": "string"
    },
    "round1_scorecard": {
      "type": "object",
      "description": "Submitted Round 1 general competency scorecard results for this candidate"
    },
    "round2_scorecard": {
      "type": "object",
      "description": "Submitted Round 2 role-specific scorecard results for this candidate"
    },
    "target_role": {
      "type": "string",
      "enum": [
        "media_specialist",
        "sales_growth_advisor",
        "other"
      ],
      "description": "Which Estate Media role this candidate is being recruited for"
    },
    "archived": {
      "type": "boolean",
      "default": false,
      "description": "Whether this candidate has been archived (declined). Archived candidates are hidden from all active Khetha IQ views but retained for audit."
    },
    "shared_person_id": {
      "type": "string",
      "description": "Cross-system person identifier linking KhethaIQ candidate to Estate Media worker"
    },
    "estate_media_specialist_id": {
      "type": "string",
      "description": "Estate Media User ID (media_partner) created/linked after hire"
    },
    "estate_employee_id": {
      "type": "string",
      "description": "SalesTeamMember ID created/linked after hire (for sales roles)"
    },
    "handoff_id": {
      "type": "string",
      "description": "Unique handoff record identifier"
    },
    "handoff_status": {
      "type": "string",
      "enum": [
        "not_started",
        "in_progress",
        "invited",
        "completed",
        "failed"
      ],
      "default": "not_started",
      "description": "Status of the KhethaIQ \u2192 Estate Media handoff"
    },
    "handoff_completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the handoff to Estate Media was completed"
    },
    "handoff_error": {
      "type": "string",
      "description": "Last handoff error, if any"
    }
  },
  "required": [
    "job_id",
    "name"
  ]
}