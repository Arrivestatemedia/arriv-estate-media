{
  "name": "ChatMessage",
  "type": "object",
  "properties": {
    "channel_id": {
      "type": "string",
      "description": "Channel ID this message belongs to"
    },
    "sender_id": {
      "type": "string",
      "description": "Sales member ID of the sender"
    },
    "sender_name": {
      "type": "string",
      "description": "Sender's full name"
    },
    "sender_email": {
      "type": "string",
      "description": "Sender's email address (used for cross-app same-company verification)"
    },
    "content": {
      "type": "string",
      "description": "Message content"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "When the message was sent"
    },
    "parent_message_id": {
      "type": "string",
      "description": "ID of parent message if this is a thread reply (null for main messages)"
    },
    "reactions": {
      "type": "object",
      "description": "Object mapping emoji to array of user IDs who reacted with that emoji",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "thread_reply_count": {
      "type": "integer",
      "default": 0,
      "description": "Number of replies in this thread (for main messages)"
    },
    "origin_app": {
      "type": "string",
      "enum": [
        "estate_media",
        "arriv_one"
      ],
      "default": "estate_media",
      "description": "Which app this message originated from"
    },
    "cross_app_channel_id": {
      "type": "string",
      "description": "Deterministic cross-app DM channel ID"
    },
    "remote_message_id": {
      "type": "string",
      "description": "Message ID in the originating remote app (for cross-app dedup)"
    }
  },
  "required": [
    "channel_id",
    "sender_id",
    "sender_name",
    "content"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}