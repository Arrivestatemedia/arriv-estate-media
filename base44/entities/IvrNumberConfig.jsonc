{
  "name": "IvrNumberConfig",
  "type": "object",
  "properties": {
    "phone_number": {
      "type": "string",
      "description": "Twilio number in E.164. One configuration per number."
    },
    "label": {
      "type": "string",
      "description": "Friendly name shown in the studio"
    },
    "line": {
      "type": "string",
      "description": "Short line label used in call records (855, 706, ...)"
    },
    "active_flow_key": {
      "type": "string",
      "description": "Published flow this number serves. Empty means the legacy production routing stays in charge."
    },
    "voice_profile_key": {
      "type": "string",
      "description": "Voice used for this number's greetings and menus"
    },
    "schedule_key": {
      "type": "string",
      "description": "Business-hours schedule applied to this number"
    },
    "caller_id_mode": {
      "type": "string",
      "enum": [
        "public_line",
        "caller_number",
        "custom"
      ],
      "enumColors": [
        "blue",
        "gray",
        "purple"
      ],
      "default": "public_line",
      "description": "What the answering representative sees"
    },
    "caller_id_number": {
      "type": "string"
    },
    "voicemail": {
      "type": "object",
      "description": "Voicemail behavior for this number",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "max_seconds": {
          "type": "number",
          "default": 180
        },
        "prompt": {
          "type": "string"
        },
        "transcribe": {
          "type": "boolean",
          "default": false
        },
        "notify_owner": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "engine_enabled": {
      "type": "boolean",
      "default": false,
      "description": "True once an administrator has pointed this Twilio number at the flow engine. Until then the existing production webhooks keep serving the line."
    },
    "twilio_sid": {
      "type": "string"
    },
    "twilio_voice_url": {
      "type": "string",
      "description": "Voice webhook currently configured in Twilio, as verified against the Twilio API"
    },
    "last_verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    },
    "updated_by": {
      "type": "string"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "phone_number"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}