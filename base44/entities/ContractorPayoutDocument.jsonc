{
  "name": "ContractorPayoutDocument",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Tenant ID for multi-tenant isolation"
    },
    "media_specialist_id": {
      "type": "string",
      "description": "Media specialist / contractor ID this document belongs to"
    },
    "media_specialist_email": {
      "type": "string",
      "description": "Media specialist email (denormalized for authorization filtering)"
    },
    "media_specialist_name": {
      "type": "string",
      "description": "Media specialist name (denormalized)"
    },
    "payroll_document_id": {
      "type": "string",
      "description": "Authoritative document ID from Arriv Payroll"
    },
    "document_type": {
      "type": "string",
      "enum": [
        "weekly_statement",
        "monthly_statement",
        "ytd_statement",
        "w9",
        "tax_document",
        "corrected_tax_document"
      ],
      "description": "Type of payout/tax document"
    },
    "title": {
      "type": "string",
      "description": "Display title for the document"
    },
    "period_start": {
      "type": "string",
      "format": "date",
      "description": "Statement period start date"
    },
    "period_end": {
      "type": "string",
      "format": "date",
      "description": "Statement period end date"
    },
    "tax_year": {
      "type": "integer",
      "description": "Tax year for annual tax documents"
    },
    "status": {
      "type": "string",
      "enum": [
        "available",
        "amended",
        "superseded",
        "withdrawn"
      ],
      "default": "available",
      "description": "Document lifecycle status"
    },
    "secure_document_reference": {
      "type": "string",
      "description": "Opaque reference used to request a signed download URL from Arriv Payroll (never a public storage URL)"
    },
    "version": {
      "type": "integer",
      "default": 1,
      "description": "Document version (incremented on amendments)"
    },
    "is_amended": {
      "type": "boolean",
      "default": false,
      "description": "Whether this document is an amendment of an earlier version"
    },
    "supersedes_document_id": {
      "type": "string",
      "description": "ID of the document this one supersedes (if amended)"
    },
    "gross_amount": {
      "type": "number",
      "description": "Gross amount shown on the statement (if applicable)"
    },
    "net_amount": {
      "type": "number",
      "description": "Net payout amount shown on the statement (if applicable)"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When Arriv Payroll generated the document"
    },
    "available_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the document became available to the contractor"
    }
  },
  "required": [
    "media_specialist_id",
    "media_specialist_email",
    "payroll_document_id",
    "document_type",
    "title",
    "secure_document_reference"
  ],
  "rls": {
    "read": {
      "data.media_specialist_email": "{{user.email}}"
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}