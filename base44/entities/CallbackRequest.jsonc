{
  "name": "CallbackRequest",
  "type": "object",
  "properties": {
    "callback_id": {
      "type": "string",
      "description": "Stable id (cb_...). One record per request, never reused."
    },
    "name": {
      "type": "string"
    },
    "phone": {
      "type": "string",
      "description": "E.164 callback number taken from the call, never invented"
    },
    "reason": {
      "type": "string",
      "description": "Brief reason the caller gave"
    },
    "category": {
      "type": "string",
      "enum": [
        "support",
        "booking",
        "sales",
        "account",
        "general"
      ],
      "enumColors": [
        "blue",
        "green",
        "purple",
        "gray",
        "gray"
      ],
      "default": "general"
    },
    "source": {
      "type": "string",
      "enum": [
        "media_specialist",
        "client",
        "b2b_client",
        "public",
        "unknown"
      ],
      "enumColors": [
        "blue",
        "green",
        "green",
        "gray",
        "gray"
      ],
      "default": "unknown"
    },
    "call_sid": {
      "type": "string",
      "description": "Twilio call this request came from, so a redelivered webhook never creates a duplicate"
    },
    "received_on_number": {
      "type": "string"
    },
    "related_signup_id": {
      "type": "string"
    },
    "related_contact_id": {
      "type": "string"
    },
    "related_organization_id": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "enum": [
        "normal",
        "high",
        "urgent"
      ],
      "enumColors": [
        "gray",
        "yellow",
        "red"
      ],
      "default": "normal"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "completed",
        "cancelled"
      ],
      "enumColors": [
        "yellow",
        "blue",
        "green",
        "gray"
      ],
      "default": "pending"
    },
    "assigned_to_email": {
      "type": "string"
    },
    "assigned_to_name": {
      "type": "string"
    },
    "assigned_to_member_id": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "requested_at": {
      "type": "string",
      "format": "date-time"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_by": {
      "type": "string"
    }
  },
  "required": [
    "callback_id",
    "phone",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}