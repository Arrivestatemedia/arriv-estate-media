{
  "name": "SmsConversation",
  "type": "object",
  "properties": {
    "from_number": {
      "type": "string",
      "description": "The external phone number (the client's number for media-specialist relay threads)"
    },
    "contact_name": {
      "type": "string",
      "description": "Optional contact name for this number"
    },
    "last_message": {
      "type": "string",
      "description": "Preview of the last message"
    },
    "last_message_at": {
      "type": "string",
      "format": "date-time",
      "description": "Time of the last message"
    },
    "unread_count": {
      "type": "integer",
      "default": 0,
      "description": "Number of unread messages"
    },
    "sales_member_id": {
      "type": "string",
      "description": "Assigned sales member ID (optional)"
    },
    "job_id": {
      "type": "string",
      "description": "Active job this conversation is relaying texts for (media-specialist relay)"
    },
    "media_partner_phone": {
      "type": "string",
      "description": "Confirmed media specialist's phone number for this relay thread"
    },
    "routing_preference": {
      "type": "string",
      "enum": [
        "unset",
        "media_partner",
        "support"
      ],
      "default": "unset",
      "description": "Client's chosen destination for their outbound texts (media partner or support)"
    },
    "record_version": {
      "type": "integer",
      "default": 1,
      "description": "Monotonic record version for sync conflict detection"
    },
    "sync_source": {
      "type": "string",
      "enum": [
        "estate_media",
        "arriv_one"
      ],
      "description": "Which application last wrote this record via sync"
    },
    "origin_event_id": {
      "type": "string",
      "description": "Inbound event ID that caused the last sync write (loop prevention)"
    },
    "immutable_shared_id": {
      "type": "string",
      "description": "Immutable cross-app shared identifier"
    }
  },
  "required": [
    "from_number"
  ]
}