{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user",
      "description": "User role in the system"
    },
    "user_type": {
      "type": "string",
      "enum": [
        "client",
        "media_partner"
      ],
      "description": "Type of user account"
    },
    "phone_number": {
      "type": "string",
      "description": "User's phone number"
    },
    "mailing_address": {
      "type": "string",
      "description": "Media partner's home/street mailing address"
    },
    "city": {
      "type": "string",
      "description": "City from the media partner's mailing address"
    },
    "zip": {
      "type": "string",
      "description": "ZIP code from the media partner's mailing address"
    },
    "coverage_area": {
      "type": "string",
      "description": "Preferred coverage area (city, ZIP, or address) the media partner works in"
    },
    "coverage_lat": {
      "type": "number",
      "description": "Latitude of the coverage area center"
    },
    "coverage_lng": {
      "type": "number",
      "description": "Longitude of the coverage area center"
    },
    "max_travel_distance": {
      "type": "number",
      "description": "Maximum distance (miles) the media partner will travel from their coverage area"
    },
    "state": {
      "type": "string",
      "description": "US state (2-letter abbreviation) the media partner works in"
    },
    "hasLoggedInBefore": {
      "type": "boolean",
      "default": false,
      "description": "Whether user has logged in before"
    },
    "firstLoginAt": {
      "type": "string",
      "format": "date-time",
      "description": "First login timestamp"
    },
    "orientationCompleted": {
      "type": "boolean",
      "default": false,
      "description": "Whether orientation is completed"
    },
    "orientationCompletedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Orientation completion timestamp"
    },
    "onboardingFeePaid": {
      "type": "boolean",
      "default": false,
      "description": "Whether onboarding fee is paid"
    },
    "onboardingFeePaidAt": {
      "type": "string",
      "format": "date-time",
      "description": "Onboarding fee payment timestamp"
    },
    "apparelPurchased": {
      "type": "boolean",
      "default": false,
      "description": "Whether the media partner purchased the shirt & jacket"
    },
    "stripeCustomerId": {
      "type": "string",
      "description": "Stripe customer ID"
    },
    "stripeOnboardingPaymentIntentId": {
      "type": "string",
      "description": "Stripe PaymentIntent ID for onboarding"
    },
    "orientationVideoUrl": {
      "type": "string",
      "description": "URL of orientation video"
    },
    "shirtFit": {
      "type": "string",
      "enum": [
        "MEN",
        "WOMEN"
      ],
      "description": "Shirt fit preference"
    },
    "shirtSize": {
      "type": "string",
      "description": "Shirt size"
    },
    "jacketSize": {
      "type": "string",
      "description": "Jacket size"
    },
    "apparelSizesConfirmedAt": {
      "type": "string",
      "format": "date-time",
      "description": "When apparel sizes were confirmed"
    },
    "addGearBag": {
      "type": "boolean",
      "default": false,
      "description": "Whether gear bag was added"
    },
    "addWaterBottle": {
      "type": "boolean",
      "default": false,
      "description": "Whether water bottle was added"
    },
    "gearBagImageUrl": {
      "type": "string",
      "description": "Gear bag product image URL"
    },
    "waterBottleImageUrl": {
      "type": "string",
      "description": "Water bottle product image URL"
    },
    "payout_method": {
      "type": "string",
      "enum": [
        "zelle",
        "bank_account",
        "stripe_connect"
      ],
      "description": "Preferred payout method"
    },
    "zelle_info": {
      "type": "string",
      "description": "Zelle phone or email"
    },
    "bank_account_last4": {
      "type": "string",
      "description": "Last 4 digits of bank account"
    },
    "stripe_account_id": {
      "type": "string",
      "description": "Stripe Connect account ID for direct-deposit payouts"
    },
    "stripe_payouts_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether the Stripe Connect account can receive payouts"
    },
    "stripe_details_submitted": {
      "type": "boolean",
      "default": false,
      "description": "Whether the partner completed Stripe Connect onboarding details"
    },
    "weekly_earnings": {
      "type": "number",
      "default": 0,
      "description": "Current week earnings"
    },
    "total_balance": {
      "type": "number",
      "default": 0,
      "description": "Total unpaid balance"
    },
    "background_check_status": {
      "type": "string",
      "enum": [
        "not_started",
        "pending",
        "clear",
        "failed"
      ],
      "default": "not_started",
      "description": "One-time background check status (Checkr)"
    },
    "checkr_candidate_id": {
      "type": "string",
      "description": "Checkr candidate ID"
    },
    "checkr_invitation_id": {
      "type": "string",
      "description": "Checkr invitation ID"
    },
    "checkr_invitation_url": {
      "type": "string",
      "description": "Checkr hosted candidate invitation URL"
    },
    "checkr_report_id": {
      "type": "string",
      "description": "Checkr report ID"
    },
    "background_check_authorized_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the partner authorized the background check"
    },
    "background_check_completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the background check result was received"
    },
    "background_check_pending_job_id": {
      "type": "string",
      "description": "Job ID the partner was booking when they initiated the background check"
    }
  },
  "required": [
    "user_type",
    "phone_number",
    "firstLoginAt",
    "orientationCompletedAt",
    "onboardingFeePaidAt",
    "stripeCustomerId",
    "stripeOnboardingPaymentIntentId",
    "orientationVideoUrl",
    "shirtFit",
    "shirtSize",
    "jacketSize",
    "apparelSizesConfirmedAt",
    "gearBagImageUrl",
    "waterBottleImageUrl",
    "payout_method",
    "zelle_info",
    "bank_account_last4"
  ]
}