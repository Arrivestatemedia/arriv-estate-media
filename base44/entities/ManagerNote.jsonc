{
  "name": "ManagerNote",
  "type": "object",
  "properties": {
    "sales_member_id": {
      "type": "string",
      "description": "The rep this note is about"
    },
    "author_id": {
      "type": "string",
      "description": "ID of the manager/admin who wrote the note"
    },
    "author_name": {
      "type": "string",
      "description": "Name of the manager who wrote the note"
    },
    "note_type": {
      "type": "string",
      "enum": [
        "coaching",
        "recognition",
        "review",
        "general"
      ],
      "default": "general",
      "description": "Type of manager note"
    },
    "content": {
      "type": "string",
      "description": "The note content"
    },
    "is_recognition": {
      "type": "boolean",
      "default": false,
      "description": "Whether this note is a recognition/award"
    },
    "award_title": {
      "type": "string",
      "description": "Title of the award if this is a recognition"
    },
    "record_version": {
      "type": "integer",
      "default": 1,
      "description": "Monotonic record version for sync conflict detection"
    },
    "sync_source": {
      "type": "string",
      "enum": [
        "estate_media",
        "arriv_one"
      ],
      "description": "Which application last wrote this record via sync"
    },
    "origin_event_id": {
      "type": "string",
      "description": "Inbound event ID that caused the last sync write (loop prevention)"
    },
    "immutable_shared_id": {
      "type": "string",
      "description": "Immutable cross-app shared identifier"
    }
  },
  "required": [
    "sales_member_id",
    "content"
  ]
}