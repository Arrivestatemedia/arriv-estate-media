{
  "name": "Job",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Canonical tenant ID for multi-tenant isolation",
      "default": "tnt_estate_media"
    },
    "title": {
      "type": "string",
      "description": "Job title"
    },
    "type": {
      "type": "string",
      "enum": [
        "photo",
        "video",
        "photo_video"
      ],
      "description": "Type of job"
    },
    "description": {
      "type": "string",
      "description": "Detailed job description"
    },
    "location": {
      "type": "string",
      "description": "Job location"
    },
    "state": {
      "type": "string",
      "description": "US state (2-letter abbreviation) of the job location"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Job date"
    },
    "start_time": {
      "type": "string",
      "description": "Start time of the job"
    },
    "duration_hours": {
      "type": "number",
      "description": "Estimated duration in hours"
    },
    "pay_rate": {
      "type": "number",
      "description": "Pay amount in dollars (contractor payout)"
    },
    "client_price": {
      "type": "number",
      "description": "Original client price (visible to admin only)"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "booked",
        "in_progress",
        "completed",
        "cancelled",
        "archived"
      ],
      "default": "open",
      "description": "OVERALL job status"
    },
    "production_status": {
      "type": "string",
      "enum": [
        "awaiting_capture",
        "awaiting_upload",
        "partial_upload",
        "ready_for_editing",
        "editing",
        "quality_control",
        "revision",
        "ready_for_delivery",
        "delivered",
        "no_editing_required"
      ],
      "default": "awaiting_capture",
      "description": "Post-production status derived from child EditingTask states"
    },
    "capture_status": {
      "type": "string",
      "enum": [
        "pending",
        "on_site",
        "captured"
      ],
      "default": "pending",
      "description": "Media Partner capture status"
    },
    "source_upload_status": {
      "type": "string",
      "enum": [
        "not_started",
        "partial",
        "complete"
      ],
      "default": "not_started",
      "description": "Source media upload status"
    },
    "delivery_status": {
      "type": "string",
      "enum": [
        "pending",
        "delivered"
      ],
      "default": "pending",
      "description": "Customer delivery status"
    },
    "media_partner_fulfillment_status": {
      "type": "string",
      "enum": [
        "pending",
        "completed"
      ],
      "default": "pending",
      "description": "Media Partner fulfillment milestone. PAYOUT ELIGIBILITY field."
    },
    "capture_fulfillment_completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the Media Partner's capture + upload fulfillment was completed"
    },
    "media_partner_status": {
      "type": "string",
      "enum": [
        "awaiting_arrival",
        "on_the_way",
        "on_site",
        "job_completed"
      ],
      "default": "awaiting_arrival",
      "description": "Media partner's current status"
    },
    "booked_by": {
      "type": "string",
      "description": "Email of the contractor who booked"
    },
    "booked_by_name": {
      "type": "string",
      "description": "Name of the contractor who booked"
    },
    "booked_by_phone": {
      "type": "string",
      "description": "Phone number of the contractor who booked"
    },
    "backup_booked_by": {
      "type": "string",
      "description": "Email of the backup contractor"
    },
    "backup_booked_by_name": {
      "type": "string",
      "description": "Name of the backup contractor"
    },
    "backup_booked_by_phone": {
      "type": "string",
      "description": "Phone number of the backup contractor"
    },
    "client_name": {
      "type": "string",
      "description": "Name of the client"
    },
    "client_email": {
      "type": "string",
      "description": "Email of the client"
    },
    "client_phone": {
      "type": "string",
      "description": "Phone number of the client"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes or requirements"
    },
    "from_booking": {
      "type": "boolean",
      "default": false,
      "description": "Whether job was created from a booking request"
    },
    "booking_id": {
      "type": "string",
      "description": "ID of the original booking that created this job"
    },
    "package": {
      "type": "string",
      "description": "Package name for the job"
    },
    "add_ons": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Selected add-ons for this job"
    },
    "on_the_way_at": {
      "type": "string",
      "format": "date-time",
      "description": "When media partner started heading to the job"
    },
    "on_site_at": {
      "type": "string",
      "format": "date-time",
      "description": "When media partner arrived on site"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When media partner completed the capture"
    },
    "google_drive_folder_url": {
      "type": "string",
      "description": "Google Drive folder URL for uploading footage"
    },
    "source_storage_provider": {
      "type": "string",
      "default": "GOOGLE_DRIVE",
      "description": "Storage provider for source media"
    },
    "source_storage_folder_id": {
      "type": "string",
      "description": "Google Drive folder ID extracted from google_drive_folder_url"
    },
    "final_edits_folder_id": {
      "type": "string",
      "description": "Google Drive folder ID for the 'Final Edits' subfolder"
    },
    "final_edits_folder_url": {
      "type": "string",
      "description": "Google Drive folder URL for the 'Final Edits' subfolder"
    },
    "footage_uploaded": {
      "type": "boolean",
      "default": false,
      "description": "Whether media partner confirmed footage upload"
    },
    "footage_reminder_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "When footage upload reminder was sent"
    },
    "delivered_to_customer": {
      "type": "boolean",
      "default": false,
      "description": "Whether the final edited media has been delivered to the customer"
    },
    "delivered_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the final edited media was delivered to the customer"
    },
    "paid_out_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this job's pay was disbursed to the media partner"
    },
    "client_payment_clears_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the client's Stripe payment settles"
    },
    "required_capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Verified capabilities required for a Media Partner to accept this job"
    },
    "pricing_snapshot_id": {
      "type": "string",
      "description": "PricingSnapshot ID with the authoritative pricing for this job"
    },
    "provider_compensation_snapshot_id": {
      "type": "string",
      "description": "ProviderCompensationSnapshot ID with the immutable guaranteed payout"
    }
  },
  "required": [
    "title",
    "type",
    "date",
    "pay_rate",
    "location"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}