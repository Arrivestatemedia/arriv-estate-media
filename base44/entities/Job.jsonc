{
  "name": "Job",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Canonical tenant ID for multi-tenant isolation",
      "default": "tnt_estate_media"
    },
    "title": {
      "type": "string",
      "description": "Job title"
    },
    "type": {
      "type": "string",
      "enum": [
        "photo",
        "video",
        "photo_video"
      ],
      "description": "Type of job"
    },
    "description": {
      "type": "string",
      "description": "Detailed job description"
    },
    "location": {
      "type": "string",
      "description": "Job location"
    },
    "state": {
      "type": "string",
      "description": "US state (2-letter abbreviation) of the job location"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Job date"
    },
    "start_time": {
      "type": "string",
      "description": "Start time of the job"
    },
    "duration_hours": {
      "type": "number",
      "description": "Estimated duration in hours"
    },
    "pay_rate": {
      "type": "number",
      "description": "Pay amount in dollars (contractor payout). For new jobs post-migration, this is the guaranteed provider payout from the compensation engine."
    },
    "client_price": {
      "type": "number",
      "description": "Original client price (visible to admin only)"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "booked",
        "in_progress",
        "completed",
        "cancelled",
        "archived"
      ],
      "default": "open",
      "description": "OVERALL job status. Only reaches 'completed' when ALL customer fulfillment (capture, upload, post-production, QC, delivery) is complete. Media Partner payout eligibility uses media_partner_fulfillment_status, NOT this field."
    },
    "production_status": {
      "type": "string",
      "enum": [
        "awaiting_capture",
        "awaiting_upload",
        "partial_upload",
        "ready_for_editing",
        "editing",
        "quality_control",
        "revision",
        "ready_for_delivery",
        "delivered",
        "no_editing_required"
      ],
      "default": "awaiting_capture",
      "description": "Post-production status derived from child EditingTask states. Server-authoritative \u2014 set by editingQueueEngine.updateJobProductionStatus()."
    },
    "capture_status": {
      "type": "string",
      "enum": [
        "pending",
        "on_site",
        "captured"
      ],
      "default": "pending",
      "description": "Media Partner capture status (derived from media_partner_status)."
    },
    "source_upload_status": {
      "type": "string",
      "enum": [
        "not_started",
        "partial",
        "complete"
      ],
      "default": "not_started",
      "description": "Source media upload status. 'complete' when all required source media is confirmed uploaded to Google Drive."
    },
    "delivery_status": {
      "type": "string",
      "enum": [
        "pending",
        "delivered"
      ],
      "default": "pending",
      "description": "Customer delivery status. 'delivered' when all editing tasks are delivered to the customer."
    },
    "media_partner_fulfillment_status": {
      "type": "string",
      "enum": [
        "pending",
        "completed"
      ],
      "default": "pending",
      "description": "Media Partner fulfillment milestone. Set to 'completed' when capture + source upload are done. This is the PAYOUT ELIGIBILITY field \u2014 Media Partner payouts depend on this, NOT Job.status. Separates capture fulfillment from overall job completion."
    },
    "capture_fulfillment_completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the Media Partner's capture + upload fulfillment was completed (payout eligibility timestamp)."
    },
    "media_partner_status": {
      "type": "string",
      "enum": [
        "awaiting_arrival",
        "on_the_way",
        "on_site",
        "job_completed"
      ],
      "default": "awaiting_arrival",
      "description": "Media partner's current status"
    },
    "booked_by": {
      "type": "string",
      "description": "Email of the contractor who booked"
    },
    "booked_by_name": {
      "type": "string",
      "description": "Name of the contractor who booked"
    },
    "booked_by_phone": {
      "type": "string",
      "description": "Phone number of the contractor who booked"
    },
    "backup_booked_by": {
      "type": "string",
      "description": "Email of the backup contractor"
    },
    "backup_booked_by_name": {
      "type": "string",
      "description": "Name of the backup contractor"
    },
    "backup_booked_by_phone": {
      "type": "string",
      "description": "Phone number of the backup contractor"
    },
    "client_name": {
      "type": "string",
      "description": "Name of the client"
    },
    "client_email": {
      "type": "string",
      "description": "Email of the client"
    },
    "client_phone": {
      "type": "string",
      "description": "Phone number of the client"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes or requirements"
    },
    "from_booking": {
      "type": "boolean",
      "default": false,
      "description": "Whether job was created from a booking request"
    },
    "booking_id": {
      "type": "string",
      "description": "ID of the original booking that created this job"
    },
    "package": {
      "type": "string",
      "description": "Package name for the job"
    },
    "add_ons": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Selected add-ons for this job"
    },
    "on_the_way_at": {
      "type": "string",
      "format": "date-time",
      "description": "When media partner started heading to the job"
    },
    "on_site_at": {
      "type": "string",
      "format": "date-time",
      "description": "When media partner arrived on site"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When media partner completed the capture (on-site completion). NOT the same as overall job completion."
    },
    "google_drive_folder_url": {
      "type": "string",
      "description": "Google Drive folder URL for uploading footage. This is the EXISTING source-media upload location \u2014 preserved and consumed by the Editing Queue."
    },
    "source_storage_provider": {
      "type": "string",
      "default": "GOOGLE_DRIVE",
      "description": "Storage provider for source media. Currently GOOGLE_DRIVE. Abstracted to permit future migration to S3 or another provider without rebuilding the Editing Queue."
    },
    "source_storage_folder_id": {
      "type": "string",
      "description": "Google Drive folder ID extracted from google_drive_folder_url. Stored separately for API-level access."
    },
    "final_edits_folder_id": {
      "type": "string",
      "description": "Google Drive folder ID for the 'Final Edits' subfolder where editors upload finished deliverables."
    },
    "final_edits_folder_url": {
      "type": "string",
      "description": "Google Drive folder URL for the 'Final Edits' subfolder."
    },
    "footage_uploaded": {
      "type": "boolean",
      "default": false,
      "description": "Whether media partner confirmed footage upload"
    },
    "footage_reminder_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "When footage upload reminder was sent"
    },
    "delivered_to_customer": {
      "type": "boolean",
      "default": false,
      "description": "Whether the final edited media has been delivered to the customer. Set by the editing queue when all editing tasks are delivered."
    },
    "delivered_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the final edited media was delivered to the customer"
    },
    "paid_out_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this job's pay was disbursed to the media partner (Stripe Connect payout)"
    },
    "client_payment_clears_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the client's Stripe payment settles into the platform balance and partner funds become available for payout. null means already cleared or not applicable."
    },
    "required_capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Verified capabilities required for a Media Partner to accept this job (photography, videography, drone, tour_3d, twilight_capture). Enforced server-side at acceptance."
    },
    "pricing_snapshot_id": {
      "type": "string",
      "description": "PricingSnapshot ID with the authoritative pricing for this job"
    },
    "provider_compensation_snapshot_id": {
      "type": "string",
      "description": "ProviderCompensationSnapshot ID with the immutable guaranteed payout"
    }
  },
  "required": [
    "title",
    "type",
    "date",
    "pay_rate",
    "location"
  ],
  "rls": {}
}