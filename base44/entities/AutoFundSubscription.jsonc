{
  "name": "AutoFundSubscription",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string",
      "description": "Customer 360 ID (Contact entity ID)"
    },
    "customer_email": {
      "type": "string",
      "description": "Denormalized for RLS and lookups"
    },
    "customer_name": {
      "type": "string"
    },
    "wallet_id": {
      "type": "string",
      "description": "Linked PrepaidWallet ID (Auto-Fund uses the same wallet)"
    },
    "amount": {
      "type": "number",
      "enum": [
        150,
        250,
        350,
        500,
        1000,
        50,
        100,
        200
      ],
      "description": "Monthly Auto-Fund wallet funding amount in dollars. This is the DEPOSIT only \u2014 the membership fee is separate. The five enrollable tiers are $150 (Starter), $250 (Growth), $350 (Professional), $500 (Premier) and $1,000 (VIP). The retired $50 / $100 / $200 values are retained so an existing subscription keeps its contracted funding amount, and they are NOT offered for new enrollment."
    },
    "membership_fee": {
      "type": "number",
      "default": 0,
      "description": "Approved monthly membership fee for this tier ($25 at $350/$500/$1,000; $0 below). Collected revenue: not spendable Booking Value, no promotional credit, no commission."
    },
    "total_monthly_charge": {
      "type": "number",
      "description": "The full recurring charge the customer authorized: wallet funding amount PLUS membership fee. Disclosed before authorization."
    },
    "plan_id": {
      "type": "string",
      "description": "Stable internal plan ID (e.g. autofund_350)"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "paused",
        "cancelled",
        "past_due"
      ],
      "default": "active"
    },
    "enrollment_channel": {
      "type": "string",
      "enum": [
        "self_service",
        "sales_assisted",
        "admin"
      ],
      "default": "admin",
      "description": "How this membership was enrolled. Both enrollment channels use the same authoritative tier configuration and the same disclosures."
    },
    "attribution_source": {
      "type": "string",
      "enum": [
        "",
        "customer_selected_advisor",
        "advisor_enrolled",
        "admin_assigned"
      ],
      "default": "",
      "description": "How the attributed advisor was established. Empty means no verified attribution, so no commission is generated. Never inferred from an advisor merely being available or from a general contact-link click."
    },
    "attribution_verified": {
      "type": "boolean",
      "default": false,
      "description": "True only when advisor attribution was deliberately verified at enrollment. Self-service enrollment with no verified advisor stays false and generates no commission."
    },
    "attribution_verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "terms_accepted_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the CUSTOMER authorized the recurring charge and its terms. A salesperson can never supply this on the customer's behalf."
    },
    "terms_accepted_by": {
      "type": "string",
      "description": "Email of the customer who authorized the recurring payment terms."
    },
    "terms_version": {
      "type": "string",
      "description": "Version label of the recurring-charge terms the customer accepted"
    },
    "fee_refund_policy": {
      "type": "string",
      "enum": [
        "undetermined",
        "non_refundable",
        "refundable_full",
        "refundable_prorated"
      ],
      "default": "undetermined",
      "description": "Refundability policy applied to this membership's fee. Disclosed to the customer before enrollment."
    },
    "billing_address_line1": {
      "type": "string",
      "description": "Customer-provided billing street address captured at enrollment"
    },
    "billing_city": {
      "type": "string",
      "description": "Customer-provided billing city captured at enrollment"
    },
    "billing_state": {
      "type": "string",
      "description": "Customer-provided billing state (2-letter code) as entered. Preserved as provided so a correction can be distinguished from the validated value."
    },
    "billing_postal_code": {
      "type": "string",
      "description": "Customer-provided billing postal code captured at enrollment"
    },
    "billing_country": {
      "type": "string",
      "description": "Customer-provided billing country (defaults to US)"
    },
    "jurisdiction_state": {
      "type": "string",
      "description": "VALIDATED billing jurisdiction (2-letter code) that drives the renewal-notice rule for this subscription. Required for new enrollment \u2014 a missing or invalid jurisdiction blocks enrollment rather than silently defaulting to a generic reminder cadence. Read by the renewal-notification engine."
    },
    "jurisdiction_resolution": {
      "type": "string",
      "enum": [
        "",
        "customer_provided_billing_address",
        "customer_provided_confirmed_by_payment_method",
        "customer_provided_conflicts_with_payment_method",
        "approved_fallback"
      ],
      "default": "",
      "description": "How the jurisdiction was established. Always from the customer's own billing address or an explicitly approved fallback \u2014 never from IP geolocation, phone number or advisor location."
    },
    "jurisdiction_captured_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the jurisdiction was captured"
    },
    "jurisdiction_updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the jurisdiction was last changed. Every change is also appended to AutoFundJurisdictionAudit."
    },
    "jurisdiction_needs_review": {
      "type": "boolean",
      "default": false,
      "description": "True when the jurisdiction case was flagged for human review instead of resolved automatically (for example a state conflict with the payment method, or a non-US billing address). Flagging does not block billing; it surfaces the case."
    },
    "jurisdiction_review_reason": {
      "type": "string",
      "description": "Machine-readable reason the jurisdiction needs review"
    },
    "certification_mode": {
      "type": "boolean",
      "default": false,
      "description": "True when this subscription was created by the isolated certification suite rather than a real customer. Excluded from production analytics and never billed."
    },
    "last_fee_charged_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the most recent membership fee was successfully collected"
    },
    "last_fee_status": {
      "type": "string",
      "enum": [
        "",
        "succeeded",
        "failed"
      ],
      "default": "",
      "description": "Outcome of the most recent membership-fee attempt"
    },
    "last_fee_failure_reason": {
      "type": "string",
      "description": "Safe failure reason for the most recent fee attempt (no card data)"
    },
    "consecutive_fee_failures": {
      "type": "integer",
      "default": 0,
      "description": "Consecutive failed membership-fee attempts. Reset to 0 on a successful fee. Tracked separately from wallet-funding failures so a failed fee cannot be mistaken for failed funding."
    },
    "stripe_subscription_id": {
      "type": "string",
      "description": "Stripe subscription ID (Arriv Pay manages billing)"
    },
    "stripe_customer_id": {
      "type": "string"
    },
    "sales_rep_id": {
      "type": "string",
      "description": "Attributed Sales Growth Advisor ID. Funded commission only \u2014 never a commission on the membership fee."
    },
    "sales_rep_email": {
      "type": "string"
    },
    "billing_day_of_month": {
      "type": "integer",
      "description": "Day of month for recurring charge (1-28)"
    },
    "next_billing_date": {
      "type": "string",
      "format": "date-time",
      "description": "Next scheduled billing date"
    },
    "paused_until": {
      "type": "string",
      "format": "date-time",
      "description": "If paused for a defined period, when to auto-resume"
    },
    "paused_at": {
      "type": "string",
      "format": "date-time"
    },
    "cancelled_at": {
      "type": "string",
      "format": "date-time"
    },
    "cancel_reason": {
      "type": "string"
    },
    "feature_flag_enabled": {
      "type": "boolean",
      "default": true
    },
    "consecutive_failed_attempts": {
      "type": "integer",
      "default": 0,
      "description": "Consecutive failed WALLET FUNDING attempts. Reset to 0 on success. Membership-fee failures are tracked separately."
    },
    "last_failure_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the most recent wallet-funding payment failure occurred"
    },
    "last_failure_reason": {
      "type": "string",
      "description": "Safe failure reason (no sensitive card data). Populated from Arriv Pay webhook."
    },
    "recovery_hold_active": {
      "type": "boolean",
      "default": false,
      "description": "True when a failed payment is unresolved. Blocks automatic charging until the customer updates their payment method or the payment is recovered."
    },
    "recovery_hold_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the recovery hold was activated"
    },
    "recovery_hold_reason": {
      "type": "string",
      "description": "Why the recovery hold is active (e.g. PAYMENT_FAILED, THREE_FAILURE_PAUSE)"
    },
    "auto_charge_paused": {
      "type": "boolean",
      "default": false,
      "description": "True after 3 consecutive failed billing attempts. Pauses all automatic charges until the customer updates their payment method and explicitly resumes."
    },
    "auto_charge_paused_at": {
      "type": "string",
      "format": "date-time",
      "description": "When automatic charging was paused after 3 failures"
    },
    "auto_charge_paused_reason": {
      "type": "string",
      "description": "Reason for auto-charge pause (e.g. THREE_CONSECUTIVE_FAILURES)"
    },
    "payment_method_updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the customer last successfully updated their payment method via the recovery flow"
    },
    "recovery_link_token": {
      "type": "string",
      "description": "Current active recovery link token (opaque, cryptographically random). Used to verify the customer identity when they open the card-update link."
    },
    "recovery_link_expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the current recovery link token expires"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "customer_id",
    "amount",
    "plan_id",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}