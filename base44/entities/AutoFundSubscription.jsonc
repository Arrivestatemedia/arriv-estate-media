{
  "name": "AutoFundSubscription",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string",
      "description": "Customer 360 ID (Contact entity ID)"
    },
    "customer_email": {
      "type": "string",
      "description": "Denormalized for RLS and lookups"
    },
    "customer_name": {
      "type": "string"
    },
    "wallet_id": {
      "type": "string",
      "description": "Linked PrepaidWallet ID (Auto-Fund uses the same wallet)"
    },
    "amount": {
      "type": "number",
      "enum": [
        50,
        100,
        200,
        350,
        500,
        1000
      ],
      "description": "Monthly Auto-Fund amount in dollars"
    },
    "plan_id": {
      "type": "string",
      "description": "Stable internal plan ID (e.g. autofund_100)"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "paused",
        "cancelled",
        "past_due"
      ],
      "default": "active"
    },
    "stripe_subscription_id": {
      "type": "string",
      "description": "Stripe subscription ID (Arriv Pay manages billing)"
    },
    "stripe_customer_id": {
      "type": "string"
    },
    "sales_rep_id": {
      "type": "string",
      "description": "Attributed Sales Growth Advisor ID"
    },
    "sales_rep_email": {
      "type": "string"
    },
    "billing_day_of_month": {
      "type": "integer",
      "description": "Day of month for recurring charge (1-28)"
    },
    "next_billing_date": {
      "type": "string",
      "format": "date-time",
      "description": "Next scheduled billing date"
    },
    "paused_until": {
      "type": "string",
      "format": "date-time",
      "description": "If paused for a defined period, when to auto-resume"
    },
    "paused_at": {
      "type": "string",
      "format": "date-time"
    },
    "cancelled_at": {
      "type": "string",
      "format": "date-time"
    },
    "cancel_reason": {
      "type": "string"
    },
    "feature_flag_enabled": {
      "type": "boolean",
      "default": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "customer_id",
    "amount",
    "plan_id",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}