{
  "name": "PendingSignup",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "description": "Email address for the pending signup"
    },
    "full_name": {
      "type": "string",
      "description": "Full name of the user"
    },
    "phone_number": {
      "type": "string",
      "description": "Phone number of the user"
    },
    "user_type": {
      "type": "string",
      "enum": [
        "client",
        "media_partner"
      ],
      "description": "Type of user"
    },
    "user_role": {
      "type": "string",
      "enum": [
        "user",
        "admin"
      ],
      "default": "user",
      "description": "Role of the user"
    },
    "password_hash": {
      "type": "string",
      "description": "SHA-256 hash of the user's password"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "completed"
      ],
      "default": "pending",
      "description": "Status of the pending signup"
    },
    "orientationCompleted": {
      "type": "boolean",
      "default": false,
      "description": "Whether media partner completed orientation"
    },
    "onboardingFeePaid": {
      "type": "boolean",
      "default": false,
      "description": "Whether media partner paid onboarding fee"
    },
    "apparelPurchased": {
      "type": "boolean",
      "default": false,
      "description": "Whether the media partner purchased the shirt & jacket"
    },
    "shirtFit": {
      "type": "string",
      "description": "Shirt fit preference (MEN or WOMEN)"
    },
    "shirtSize": {
      "type": "string",
      "description": "Shirt size selection"
    },
    "jacketSize": {
      "type": "string",
      "description": "Jacket size selection"
    },
    "addGearBag": {
      "type": "boolean",
      "default": false,
      "description": "Whether media partner added gear bag"
    },
    "addWaterBottle": {
      "type": "boolean",
      "default": false,
      "description": "Whether media partner added water bottle"
    },
    "apparelSizesConfirmedAt": {
      "type": "string",
      "format": "date-time",
      "description": "When apparel sizes were confirmed"
    },
    "coverage_area": {
      "type": "string",
      "description": "Preferred coverage area (city, ZIP, or address) the media partner works in"
    },
    "coverage_lat": {
      "type": "number",
      "description": "Latitude of the coverage area center"
    },
    "coverage_lng": {
      "type": "number",
      "description": "Longitude of the coverage area center"
    },
    "max_travel_distance": {
      "type": "number",
      "description": "Maximum distance (miles) the media partner will travel from their coverage area"
    },
    "state": {
      "type": "string",
      "description": "US state (2-letter abbreviation) derived from the coverage area"
    },
    "deletion_requested_date": {
      "type": "string",
      "format": "date-time",
      "description": "Date when deletion was requested"
    },
    "deletion_token": {
      "type": "string",
      "description": "Token for immediate deletion verification"
    },
    "payout_method": {
      "type": "string",
      "enum": [
        "zelle",
        "bank_account",
        "stripe_connect"
      ],
      "description": "Payout method for media partners"
    },
    "zelle_info": {
      "type": "string",
      "description": "Zelle phone number or email"
    },
    "bank_account_number": {
      "type": "string",
      "description": "Bank account number"
    },
    "bank_account_last4": {
      "type": "string",
      "description": "Last 4 digits of bank account"
    },
    "bank_routing_number": {
      "type": "string",
      "description": "Bank routing number"
    },
    "stripe_account_id": {
      "type": "string",
      "description": "Stripe Connect account ID for direct-deposit payouts"
    },
    "stripe_payouts_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether the Stripe Connect account can receive payouts"
    },
    "stripe_details_submitted": {
      "type": "boolean",
      "default": false,
      "description": "Whether the partner completed Stripe Connect onboarding details"
    }
  },
  "required": [
    "email",
    "full_name",
    "phone_number",
    "user_type",
    "password_hash"
  ]
}