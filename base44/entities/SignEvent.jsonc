{
  "name": "SignEvent",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Tenant ID for multi-tenant isolation",
      "default": "tnt_estate_media"
    },
    "event_id": {
      "type": "string",
      "description": "Stable event identifier (e.g. sev_xxx). Cryptographically unique."
    },
    "request_id": {
      "type": "string",
      "description": "SignRequest.request_id this event belongs to"
    },
    "sign_group_id": {
      "type": "string",
      "description": "Links events across a multi-signer sign_group_id"
    },
    "document_id": {
      "type": "string",
      "description": "SignDocument.document_id this event pertains to"
    },
    "document_title": {
      "type": "string",
      "description": "Snapshot of the document title at event time"
    },
    "document_category": {
      "type": "string",
      "enum": [
        "agreement",
        "hr_document",
        "regular_document"
      ],
      "default": "regular_document",
      "description": "Category label copied from the SignDocument at event time"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "REQUEST_SENT",
        "VIEWED",
        "SIGNED",
        "DECLINED",
        "VOIDED",
        "EXPIRED",
        "REMINDER_SENT",
        "COMPLETED",
        "CERTIFICATE_GENERATED"
      ],
      "description": "Type of signing lifecycle event"
    },
    "actor_email": {
      "type": "string",
      "description": "Email of the person who triggered this event"
    },
    "actor_name": {
      "type": "string",
      "description": "Display name of the actor"
    },
    "actor_type": {
      "type": "string",
      "enum": [
        "admin",
        "sales_rep",
        "signer",
        "system"
      ],
      "default": "system",
      "description": "Role classification of the actor"
    },
    "recipient_email": {
      "type": "string",
      "description": "Email of the recipient this event pertains to (for multi-signer docs)"
    },
    "recipient_name": {
      "type": "string",
      "description": "Name of the recipient"
    },
    "metadata_json": {
      "type": "string",
      "description": "JSON-encoded event metadata (field_id, reason, reminder_number, etc.)"
    },
    "ip_address": {
      "type": "string",
      "description": "IP address of the actor (audit trail)"
    },
    "user_agent": {
      "type": "string",
      "description": "User-Agent of the actor (audit trail)"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "When this event occurred"
    }
  },
  "required": [
    "event_id",
    "request_id",
    "event_type",
    "timestamp"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}