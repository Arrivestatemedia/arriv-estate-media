{
  "name": "RecruitingTask",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "follow_up",
        "outreach",
        "review",
        "schedule_interview",
        "other"
      ],
      "description": "Task type"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "When the task is due"
    },
    "prospect_id": {
      "type": "string",
      "description": "RecruitingProspect ID this task is about"
    },
    "prospect_name": {
      "type": "string",
      "description": "Prospect name (denormalized)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "completed"
      ],
      "default": "pending",
      "description": "Task status"
    },
    "notes": {
      "type": "string",
      "description": "Task notes"
    },
    "assigned_to": {
      "type": "string",
      "description": "User ID assigned to this task"
    },
    "assigned_to_name": {
      "type": "string",
      "description": "Assignee name (denormalized)"
    },
    "job_id": {
      "type": "string",
      "description": "HireJob ID this task relates to"
    }
  },
  "required": [
    "type"
  ]
}