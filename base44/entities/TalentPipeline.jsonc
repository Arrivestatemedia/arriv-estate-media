{
  "name": "TalentPipeline",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Pipeline name"
    },
    "job_id": {
      "type": "string",
      "description": "Optional HireJob this pipeline feeds"
    },
    "target_roles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Roles to source for"
    },
    "target_skills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "target_locations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Zip codes or city names"
    },
    "target_radius_miles": {
      "type": "number",
      "default": 25
    },
    "continuous_recruiting_enabled": {
      "type": "boolean",
      "default": false
    },
    "search_frequency_days": {
      "type": "integer",
      "default": 7
    },
    "max_prospects_per_cycle": {
      "type": "integer",
      "default": 15
    },
    "last_run_at": {
      "type": "string",
      "format": "date-time"
    },
    "prospect_count": {
      "type": "integer",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "created_by_name": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ]
}