{
  "name": "B2BOrganization",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "description": "Canonical B2B organization ID (unique). Generated as b2borg_{timestamp}_{random}."
    },
    "account_id": {
      "type": "string",
      "description": "Reference to the existing Account entity (optional \u2014 Account schema is NOT modified). Read-only link."
    },
    "legal_name": {
      "type": "string",
      "description": "Legal organization name"
    },
    "display_name": {
      "type": "string",
      "description": "Display name for UI"
    },
    "billing_contact_email": {
      "type": "string",
      "description": "Primary billing contact email"
    },
    "billing_contact_name": {
      "type": "string"
    },
    "billing_contact_phone": {
      "type": "string"
    },
    "primary_admin_user_id": {
      "type": "string",
      "description": "User ID of the primary organization admin"
    },
    "primary_admin_email": {
      "type": "string"
    },
    "assigned_sales_rep_id": {
      "type": "string",
      "description": "SalesTeamMember ID of the assigned sales rep"
    },
    "assigned_sales_rep_email": {
      "type": "string"
    },
    "contract_type": {
      "type": "string",
      "enum": [
        "business",
        "portfolio",
        "developer",
        "enterprise",
        "reserved_capacity",
        "custom_enterprise"
      ],
      "description": "Type of B2B contract"
    },
    "plan_id": {
      "type": "string",
      "description": "Active plan ID (business/portfolio/developer/enterprise) or 'reserved_capacity' / 'custom_enterprise'"
    },
    "contract_status": {
      "type": "string",
      "enum": [
        "prospective",
        "quoted",
        "contract_sent",
        "awaiting_signature",
        "awaiting_payment",
        "active",
        "implementing",
        "live",
        "suspended",
        "churned",
        "renewed",
        "expanded"
      ],
      "default": "prospective",
      "description": "Current contract status"
    },
    "contract_start_date": {
      "type": "string",
      "format": "date"
    },
    "contract_end_date": {
      "type": "string",
      "format": "date"
    },
    "billing_frequency": {
      "type": "string",
      "enum": [
        "monthly",
        "annual_prepaid"
      ],
      "description": "Billing frequency"
    },
    "annual_prepaid": {
      "type": "boolean",
      "default": false,
      "description": "Whether this contract is annual prepaid"
    },
    "renewal_type": {
      "type": "string",
      "enum": [
        "auto_renew",
        "manual_renew",
        "month_to_month",
        "non_renewing"
      ],
      "default": "manual_renew"
    },
    "seat_counts": {
      "type": "object",
      "properties": {
        "included_full_seats": {
          "type": "integer"
        },
        "included_admin_seats": {
          "type": "integer"
        },
        "additional_full_seats": {
          "type": "integer",
          "default": 0
        },
        "additional_admin_seats": {
          "type": "integer",
          "default": 0
        },
        "booking_only_seats": {
          "type": "integer",
          "default": 0
        }
      },
      "description": "Seat counts for this organization"
    },
    "implementation_status": {
      "type": "string",
      "enum": [
        "not_started",
        "in_progress",
        "complete",
        "blocked"
      ],
      "default": "not_started"
    },
    "credit_entitlement": {
      "type": "number",
      "description": "Monthly media credit entitlement (for credit-based plans)"
    },
    "capacity_entitlement": {
      "type": "object",
      "properties": {
        "production_standard": {
          "type": "string",
          "enum": [
            "essentials",
            "cinematic",
            "premium"
          ]
        },
        "contracted_shoots": {
          "type": "integer"
        }
      },
      "description": "Reserved capacity entitlement (for capacity contracts)"
    },
    "stripe_customer_id": {
      "type": "string",
      "description": "Stripe customer ID for this organization"
    },
    "stripe_subscription_id": {
      "type": "string",
      "description": "Stripe subscription ID for the active contract"
    },
    "current_contract_version_id": {
      "type": "string",
      "description": "ID of the current B2BContractVersion"
    },
    "current_contract_id": {
      "type": "string",
      "description": "ID of the current B2BContract"
    },
    "account_health": {
      "type": "string",
      "enum": [
        "healthy",
        "at_risk",
        "critical",
        "churned"
      ],
      "default": "healthy"
    },
    "renewal_date": {
      "type": "string",
      "format": "date",
      "description": "Upcoming renewal date"
    },
    "preferred_stacking_eligible": {
      "type": "boolean",
      "default": false,
      "description": "Whether Preferred membership benefits can stack with B2B contract. Default false per \u00a7XXXVII \u2014 B2B economics take precedence."
    },
    "delinquency_tier": {
      "type": "string",
      "enum": [
        "individual_agent_small_team",
        "small_midsize_brokerage",
        "large_brokerage_property_mgmt",
        "enterprise_developer_corporate",
        "unclassified"
      ],
      "description": "Explicit delinquency classification tier. Set by admin based on customer size, NOT contract_type. Determines grace period (7/14/21/30 days). 'unclassified' flags for admin review."
    },
    "booking_restricted": {
      "type": "boolean",
      "default": false,
      "description": "Whether new booking creation is restricted due to payment delinquency (grace period expired). Existing paid bookings, completed jobs, and delivered media are always preserved."
    },
    "booking_restricted_at": {
      "type": "string",
      "format": "date-time",
      "description": "When booking restriction was applied"
    },
    "booking_restriction_reason": {
      "type": "string",
      "description": "Reason for booking restriction (GRACE_EXPIRED, ENTERPRISE_APPROVAL_GRANTED, etc.)"
    },
    "delinquency_outstanding_balance": {
      "type": "number",
      "description": "Total outstanding balance across all unpaid B2B invoices"
    },
    "delinquency_invoice_count": {
      "type": "integer",
      "description": "Count of unpaid B2B invoices"
    },
    "delinquency_oldest_past_due_date": {
      "type": "string",
      "format": "date",
      "description": "Due date of the oldest past-due invoice"
    },
    "delinquency_days_past_due_max": {
      "type": "integer",
      "description": "Maximum days past due across all outstanding invoices"
    },
    "management_exception_active": {
      "type": "boolean",
      "default": false,
      "description": "Whether a management exception or payment arrangement is currently active"
    },
    "enterprise_restriction_approved_by": {
      "type": "string",
      "description": "Admin who explicitly approved booking restriction for an enterprise account"
    },
    "enterprise_restriction_approved_at": {
      "type": "string",
      "format": "date-time",
      "description": "When enterprise booking restriction was explicitly approved"
    },
    "certification_mode": {
      "type": "boolean",
      "default": false,
      "description": "True if this is a synthetic certification test organization (cert_-prefixed). Excluded from production analytics."
    }
  },
  "required": [
    "organization_id",
    "legal_name",
    "contract_status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}