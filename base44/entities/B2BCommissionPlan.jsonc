{
  "name": "B2BCommissionPlan",
  "type": "object",
  "properties": {
    "config_version": {
      "type": "string",
      "description": "Canonical config version ID (e.g. AEM_B2B_COMMISSION_V1)"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "effective_date": {
      "type": "string",
      "format": "date"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "config_json": {
      "type": "string",
      "description": "Full canonical JSON: implementation_commission_rate (0.60), recurring (15%/8%/5%), annual_close_bonus (1.5%/3%, cap $7,500), renewal_bonus (1%, cap $2,500), expansion (15%/8%/5%), rep_departure rules"
    },
    "current_version_id": {
      "type": "string",
      "description": "ID of the active B2BCommissionPlanVersion"
    },
    "activated_at": {
      "type": "string",
      "format": "date-time"
    },
    "activated_by": {
      "type": "string"
    },
    "change_reason": {
      "type": "string"
    }
  },
  "required": [
    "config_version",
    "is_active",
    "config_json"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}