{
  "name": "PerformanceObservation",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Canonical tenant ID for multi-tenant isolation",
      "default": "tnt_estate_media"
    },
    "source_id": {
      "type": "string",
      "description": "PerformanceDataSource source_id this observation came from"
    },
    "candidate_id": {
      "type": "string",
      "description": "HireCandidate ID this observation is linked to"
    },
    "job_id": {
      "type": "string",
      "description": "HireJob ID (if known)"
    },
    "match_status": {
      "type": "string",
      "enum": [
        "auto_matched",
        "confirmed",
        "unmatched"
      ],
      "default": "auto_matched",
      "description": "How this observation was matched to a candidate"
    },
    "is_test": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is a test observation (never counts as real learning evidence)"
    },
    "metric_key": {
      "type": "string",
      "description": "Metric identifier (e.g. 'quota_attainment', 'win_rate', 'performance_rating', 'goal_completion')"
    },
    "value": {
      "type": "number",
      "description": "Numeric value of the metric"
    },
    "period_start": {
      "type": "string",
      "format": "date",
      "description": "Start of the measurement period"
    },
    "period_end": {
      "type": "string",
      "format": "date",
      "description": "End of the measurement period"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the observation was recorded"
    },
    "source_record_id": {
      "type": "string",
      "description": "External record ID from the source system (for deduplication)"
    }
  },
  "required": [
    "source_id",
    "metric_key"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}