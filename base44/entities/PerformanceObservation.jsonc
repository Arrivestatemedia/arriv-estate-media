{
  "name": "PerformanceObservation",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Canonical tenant ID for multi-tenant isolation",
      "default": "tnt_estate_media"
    },
    "source_id": {
      "type": "string",
      "description": "PerformanceDataSource source_id this observation came from"
    },
    "match_status": {
      "type": "string",
      "enum": [
        "auto_matched",
        "confirmed",
        "unmatched"
      ],
      "default": "auto_matched",
      "description": "How this observation was identity-matched"
    },
    "is_test": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is a synthetic test observation (never counts as real learning evidence)"
    },
    "metric_key": {
      "type": "string",
      "description": "Name of the performance metric (e.g. quota_attainment, win_rate, deals_closed)"
    },
    "value": {
      "type": "string",
      "description": "Value of the metric (stored as string; numeric values parsed by consumers)"
    },
    "period_start": {
      "type": "string",
      "format": "date",
      "description": "Start of the performance period"
    },
    "period_end": {
      "type": "string",
      "format": "date",
      "description": "End of the performance period"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the observation was recorded"
    },
    "candidate_id": {
      "type": "string",
      "description": "HireCandidate ID if matched to a candidate"
    },
    "job_id": {
      "type": "string",
      "description": "HireJob ID if matched to a job"
    },
    "identity_email": {
      "type": "string",
      "description": "Email used for identity matching"
    },
    "external_employee_id": {
      "type": "string",
      "description": "External employee ID used for identity matching"
    },
    "source_record_id": {
      "type": "string",
      "description": "Original record ID from the source system (for dedup)"
    }
  },
  "required": [
    "source_id",
    "metric_key"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}