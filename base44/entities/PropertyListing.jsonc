{
  "name": "PropertyListing",
  "type": "object",
  "properties": {
    "listing_id": {
      "type": "string",
      "description": "Stable, globally unique listing ID (prop_...). Never reused."
    },
    "tenant_id": {
      "type": "string",
      "default": "tnt_estate_media",
      "description": "Multi-tenant isolation key. Carried so the record moves cleanly to a future independent-agent or brokerage context."
    },
    "job_id": {
      "type": "string",
      "description": "Completed media job this property page was derived from. One property page per job."
    },
    "booking_id": {
      "type": "string",
      "description": "Booking the verified property details were taken from, when one exists."
    },
    "duplicate_key": {
      "type": "string",
      "description": "Deterministic key (job id + normalized address) used to prevent a second property page for the same property. Unique in practice; checked before any create."
    },
    "client_email": {
      "type": "string",
      "description": "Email of the customer who owns the delivered media and is authorized to approve publication. Ownership is verified against the job's client_email."
    },
    "client_name": {
      "type": "string"
    },
    "property_address": {
      "type": "string",
      "description": "Street address of the property as supplied or verified. Never generated by AI."
    },
    "normalized_address": {
      "type": "string",
      "description": "Normalized address for search and duplicate detection"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string",
      "description": "Two-letter state code"
    },
    "zip": {
      "type": "string"
    },
    "listing_price": {
      "type": "number",
      "description": "Asking price supplied by the customer or agent. Null when not supplied \u2014 never estimated."
    },
    "bedrooms": {
      "type": "integer"
    },
    "bathrooms": {
      "type": "number"
    },
    "square_footage": {
      "type": "integer",
      "description": "Square footage. Reused from verified booking property data when present."
    },
    "square_footage_source": {
      "type": "string",
      "description": "Where the square footage came from (verified booking data, customer supplied)"
    },
    "property_type": {
      "type": "string",
      "description": "Property type (house, condo, townhouse, land, multi_family, other)"
    },
    "property_description": {
      "type": "string",
      "description": "Customer-approved property description. AI may draft it, but only the customer's approved text is ever published."
    },
    "amenities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Relevant amenities supplied by the customer or agent"
    },
    "listing_status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "pending",
        "sold",
        "withdrawn",
        "expired"
      ],
      "default": "draft",
      "description": "Listing availability. Only 'active' and 'pending' can appear as available; sold, withdrawn and expired are never presented as available."
    },
    "status_confirmation_due_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the next listing-status confirmation is required. Recomputed on every confirmation."
    },
    "last_status_confirmed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the customer or agent last confirmed the listing status is still accurate. Drives the documented deactivation policy."
    },
    "last_status_confirmed_by": {
      "type": "string"
    },
    "last_status_change_at": {
      "type": "string",
      "format": "date-time"
    },
    "agent_name": {
      "type": "string",
      "description": "Listing agent credited on the page"
    },
    "agent_email": {
      "type": "string",
      "description": "Authorized listing contact. Inquiries are routed only here."
    },
    "agent_phone": {
      "type": "string"
    },
    "agent_license_number": {
      "type": "string",
      "description": "Agent license number when supplied (required by some jurisdictions)"
    },
    "agent_photo_url": {
      "type": "string",
      "description": "Headshot the listing contact deliberately supplied for this page, as a publicly served image URL. Uploaded publicly because the public page renders without a session; only an image the contact supplied is ever stored here."
    },
    "brokerage_name": {
      "type": "string"
    },
    "brokerage_id": {
      "type": "string",
      "description": "Brokerage identifier. Reserved for a future brokerage-owned account model."
    },
    "authority_confirmed": {
      "type": "boolean",
      "default": false,
      "description": "The agent has confirmed authority to advertise this property and to use the selected media."
    },
    "authority_confirmed_at": {
      "type": "string",
      "format": "date-time"
    },
    "authority_confirmed_by": {
      "type": "string",
      "description": "Email of the person who confirmed authority"
    },
    "brokerage_approved": {
      "type": "boolean",
      "default": false,
      "description": "Applicable brokerage approval for advertising this listing has been obtained."
    },
    "brokerage_approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "disclosures_accepted": {
      "type": "boolean",
      "default": false,
      "description": "Advertising disclosures have been shown and accepted before publication."
    },
    "disclosures_accepted_at": {
      "type": "string",
      "format": "date-time"
    },
    "disclosures_snapshot": {
      "type": "string",
      "description": "Plain-text snapshot of the disclosures accepted, preserved as evidence"
    },
    "approved_contact_email": {
      "type": "string",
      "description": "Approved public contact email for inquiries"
    },
    "approved_contact_phone": {
      "type": "string",
      "description": "Approved public contact phone for inquiries"
    },
    "selected_media": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "drive_file_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "photo",
              "video"
            ]
          },
          "alt_text": {
            "type": "string"
          },
          "position": {
            "type": "integer"
          }
        }
      },
      "description": "Customer-selected media in the customer's approved order. Files stay in the job's private Google Drive folder \u2014 nothing is copied or re-uploaded, and only these assets can ever be served publicly."
    },
    "cover_file_id": {
      "type": "string",
      "description": "Drive file id of the selected cover photograph"
    },
    "include_video": {
      "type": "boolean",
      "default": false,
      "description": "Whether delivered video is included on the public page"
    },
    "media_selection_approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "publication_state": {
      "type": "string",
      "enum": [
        "DRAFT",
        "READY_FOR_REVIEW",
        "APPROVED",
        "PUBLISHED",
        "UNPUBLISHED",
        "ARCHIVED"
      ],
      "default": "DRAFT",
      "description": "Publication state machine. Only PUBLISHED listings are publicly reachable. Transitions are validated server-side."
    },
    "publication_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from_state": {
            "type": "string"
          },
          "to_state": {
            "type": "string"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "actor": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      },
      "description": "Append-only publication history"
    },
    "approving_account": {
      "type": "string",
      "description": "Account that approved publication. Only an authorized customer (or an admin on their behalf with recorded consent) may approve."
    },
    "approval_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "publication_consent": {
      "type": "string",
      "description": "Snapshot of the explicit publication consent text the approving account accepted"
    },
    "publication_consent_at": {
      "type": "string",
      "format": "date-time"
    },
    "approved_property_details_snapshot": {
      "type": "object",
      "description": "The exact property details in force when publication was approved"
    },
    "approved_media_snapshot": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "The exact media selection and order in force when publication was approved"
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "unpublished_at": {
      "type": "string",
      "format": "date-time"
    },
    "archived_at": {
      "type": "string",
      "format": "date-time"
    },
    "content_approved_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the customer reviewed and approved the factual content. AI drafts are never published without this."
    },
    "content_approved_by": {
      "type": "string"
    },
    "public_slug": {
      "type": "string",
      "description": "Crawlable, human-readable URL slug (address based). Unique across listings."
    },
    "public_url": {
      "type": "string",
      "description": "Canonical public property page URL"
    },
    "canonical_url": {
      "type": "string",
      "description": "Canonical URL emitted in the page metadata. Always the public property page, never a tracking or stream URL."
    },
    "seo_title": {
      "type": "string",
      "description": "Search-friendly page title, customer approved"
    },
    "meta_description": {
      "type": "string",
      "description": "Unique meta description, customer approved"
    },
    "structured_data": {
      "type": "object",
      "description": "JSON-LD structured data generated for the page (RealEstateListing style)"
    },
    "seo_generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When SEO content was last generated. Regeneration is driven by seo_source_hash, never on a schedule."
    },
    "seo_source_hash": {
      "type": "string",
      "description": "Hash of the inputs the SEO content was generated from. SEO content is regenerated only when relevant information actually changes."
    },
    "content_hash": {
      "type": "string",
      "description": "Hash of the currently approved content (details + media selection)"
    },
    "ai_draft": {
      "type": "object",
      "description": "Latest AI-drafted description, title, meta description and image alt text. A draft only \u2014 never published as-is.",
      "properties": {
        "property_description": {
          "type": "string"
        },
        "seo_title": {
          "type": "string"
        },
        "meta_description": {
          "type": "string"
        },
        "alt_texts": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "ai_generation_count": {
      "type": "integer",
      "default": 0,
      "description": "Number of AI content generations for this listing. Used to prove cost control: content is generated once and regenerated only on relevant change."
    },
    "sitemap_included": {
      "type": "boolean",
      "default": false,
      "description": "Whether the listing is included in the public sitemap. Only published, publicly active listings are included."
    },
    "inquiry_count": {
      "type": "integer",
      "default": 0
    },
    "reso": {
      "type": "object",
      "description": "RESO-aligned field mapping reserved for a future MLS/IDX integration. Populated for new listings; not used by MLS operations in v1.0.",
      "properties": {
        "reso_listing_key": {
          "type": "string"
        },
        "standard_status": {
          "type": "string"
        },
        "property_sub_type": {
          "type": "string"
        },
        "listing_service_name": {
          "type": "string"
        }
      }
    },
    "certification_mode": {
      "type": "boolean",
      "default": false,
      "description": "True for synthetic certification listings. Excluded from the public directory and from production reporting."
    },
    "certification_run_id": {
      "type": "string",
      "description": "Certification run that created this synthetic listing. Empty for real customer listings; lets a run's fixtures be identified and swept even if the run was interrupted before its own teardown."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "listing_id",
    "job_id",
    "client_email",
    "publication_state"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}