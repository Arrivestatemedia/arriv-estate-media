{
  "name": "Booking",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Canonical tenant ID for multi-tenant isolation",
      "default": "tnt_estate_media"
    },
    "client_name": {
      "type": "string",
      "description": "Client's full name"
    },
    "client_email": {
      "type": "string",
      "description": "Client's email address"
    },
    "client_phone": {
      "type": "string",
      "description": "Client's phone number"
    },
    "package": {
      "type": "string",
      "enum": [
        "mls_walkthrough",
        "photo_essentials",
        "photo_cinematic",
        "premium_bundle"
      ],
      "description": "Selected package"
    },
    "add_ons": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Selected add-ons"
    },
    "street_address": {
      "type": "string",
      "description": "Street address and house number"
    },
    "city": {
      "type": "string",
      "description": "City"
    },
    "state": {
      "type": "string",
      "description": "State"
    },
    "preferred_date": {
      "type": "string",
      "format": "date",
      "description": "Preferred shoot date"
    },
    "preferred_time": {
      "type": "string",
      "description": "Preferred shoot time"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes or requirements"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "approved",
        "completed",
        "cancelled",
        "denied"
      ],
      "default": "pending",
      "description": "Booking status"
    },
    "total_price": {
      "type": "number",
      "description": "Total calculated price (legacy field)"
    },
    "custom_price_text": {
      "type": "string",
      "description": "Custom text to display instead of total_price"
    },
    "request_pay_at_closing": {
      "type": "boolean",
      "default": false,
      "description": "Whether client requested pay-at-closing option"
    },
    "payment_locked": {
      "type": "boolean",
      "default": false,
      "description": "Whether approval buttons are locked pending payment"
    },
    "invoice_id": {
      "type": "string",
      "description": "Related invoice ID"
    },
    "property_address": {
      "type": "string",
      "description": "Original property address as entered"
    },
    "normalized_address": {
      "type": "string",
      "description": "Normalized/validated property address"
    },
    "property_sqft": {
      "type": "number",
      "description": "Property square footage used for pricing"
    },
    "property_sqft_source": {
      "type": "string",
      "description": "Source of sqft data"
    },
    "property_sqft_verified": {
      "type": "boolean",
      "default": false,
      "description": "Whether sqft was verified by a property-data provider"
    },
    "property_pricing_tier": {
      "type": "string",
      "description": "Pricing tier determined from sqft"
    },
    "pricing_snapshot_id": {
      "type": "string",
      "description": "PricingSnapshot ID with the authoritative pricing calculation"
    },
    "commissionable_service_value": {
      "type": "integer",
      "description": "Commissionable service value after discounts, in CENTS"
    },
    "preferred_discount": {
      "type": "integer",
      "description": "Preferred discount applied, in CENTS"
    },
    "approved_discount_amount": {
      "type": "integer",
      "description": "Approved true discount amount, in CENTS"
    },
    "referral_tender_amount": {
      "type": "integer",
      "description": "Referral reward tender applied, in CENTS"
    },
    "wallet_applied_cents": {
      "type": "integer",
      "default": 0,
      "description": "Booking value paid from the Arriv Wallet, in CENTS. 0 = no wallet used (standard cash booking)."
    },
    "wallet_id": {
      "type": "string",
      "description": "PrepaidWallet id redeemed for this booking (empty when no wallet was used)"
    },
    "wallet_funding_source": {
      "type": "string",
      "enum": [
        "none",
        "auto_fund",
        "prepaid",
        "mixed"
      ],
      "default": "none",
      "description": "Which program funded the wallet balance redeemed for this booking. Informational/disclosure \u2014 Auto-Fund redemptions issue 'reload' lots, Prepaid 'purchase' lots."
    },
    "booking_funding_classification": {
      "type": "string",
      "enum": [
        "standard_marketplace",
        "wallet_funded"
      ],
      "default": "standard_marketplace",
      "description": "Reliable server-side booking classification. 'wallet_funded' bookings (Auto-Fund or Prepaid redemption) generate ZERO booking-level sales commission \u2014 the advisor was already compensated at funding time. Standard marketplace bookings keep the existing 15% marketplace commission."
    },
    "ordering_user_email": {
      "type": "string",
      "description": "Verified person who placed the order. Always the signed-in customer, never a company name."
    },
    "purchasing_context": {
      "type": "string",
      "enum": [
        "personal",
        "organization"
      ],
      "default": "personal",
      "description": "The purchasing context explicitly chosen at checkout. An order never changes context on its own."
    },
    "purchasing_organization_id": {
      "type": "string",
      "description": "B2BOrganization record id that owns this order. Empty for personal orders."
    },
    "purchasing_organization_name": {
      "type": "string",
      "description": "Organization display name captured at order time"
    },
    "b2b_organization_member_id": {
      "type": "string",
      "description": "B2BOrganizationMember row that authorized this company order"
    },
    "b2b_contract_id": {
      "type": "string",
      "description": "Governing B2B contract applied to this order (company orders only)"
    },
    "credit_source": {
      "type": "string",
      "enum": [
        "personal",
        "personal_cash",
        "personal_prepaid",
        "personal_auto_fund",
        "b2b_media_credit",
        "b2b_reserved_capacity",
        "b2b_contract"
      ],
      "default": "personal",
      "description": "Which pool funded this order. Personal and company pools are never interchangeable."
    },
    "b2b_credit_reservation_id": {
      "type": "string",
      "description": "Reservation id written to the company credit ledger for this order"
    },
    "b2b_credit_units_reserved": {
      "type": "integer",
      "description": "Company credit units reserved for this order. 0 when no company credits were applied."
    },
    "b2b_credit_status": {
      "type": "string",
      "enum": [
        "not_applicable",
        "pending",
        "reserved",
        "insufficient_company_credits",
        "needs_review",
        "reservation_failed"
      ],
      "default": "not_applicable",
      "description": "Company credit state for this order. 'not_applicable' means a personal order."
    },
    "b2b_credit_note": {
      "type": "string",
      "description": "Plain-language reason the company credit step did not complete, when it did not"
    }
  },
  "required": [
    "client_name",
    "client_email",
    "street_address",
    "city",
    "state",
    "preferred_date"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}