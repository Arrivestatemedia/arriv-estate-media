{
  "name": "ActivityLog",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Canonical tenant ID for multi-tenant isolation",
      "default": "tnt_estate_media"
    },
    "activity_type": {
      "type": "string",
      "enum": [
        "call",
        "email",
        "meeting",
        "task",
        "note"
      ],
      "description": "Type of activity"
    },
    "contact_email": {
      "type": "string",
      "description": "Contact email address"
    },
    "contact_name": {
      "type": "string",
      "description": "Contact name"
    },
    "company_name": {
      "type": "string",
      "description": "Company name"
    },
    "activity_date": {
      "type": "string",
      "format": "date-time",
      "description": "Date and time of activity"
    },
    "notes": {
      "type": "string",
      "description": "Summary or notes about the activity"
    },
    "call_map": {
      "type": "string",
      "description": "Auto-generated call map for the activity"
    },
    "duration_minutes": {
      "type": "number",
      "description": "Duration of call or meeting in minutes"
    },
    "picture_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of picture URLs attached to the activity"
    },
    "missed": {
      "type": "boolean",
      "default": false,
      "description": "Whether this was a missed incoming call"
    },
    "missed_acknowledged": {
      "type": "boolean",
      "default": false,
      "description": "Whether the sales rep has seen/dismissed the missed call badge"
    },
    "hubspot_synced": {
      "type": "boolean",
      "default": false,
      "description": "Whether activity was synced to HubSpot"
    },
    "hubspot_engagement_id": {
      "type": "string",
      "description": "HubSpot engagement ID"
    },
    "sync_error": {
      "type": "string",
      "description": "Error message if sync failed"
    },
    "sales_member_id": {
      "type": "string",
      "description": "ID of the sales team member who logged this activity"
    },
    "sales_member_email": {
      "type": "string",
      "description": "Email of the sales team member who logged this activity"
    },
    "record_version": {
      "type": "integer",
      "default": 1,
      "description": "Monotonic record version for sync conflict detection"
    },
    "sync_source": {
      "type": "string",
      "enum": [
        "estate_media",
        "arriv_one"
      ],
      "description": "Which application last wrote this record via sync"
    },
    "origin_event_id": {
      "type": "string",
      "description": "Inbound event ID that caused the last sync write (loop prevention)"
    },
    "immutable_shared_id": {
      "type": "string",
      "description": "Immutable cross-app shared identifier"
    }
  },
  "required": [
    "activity_type",
    "activity_date",
    "notes"
  ],
  "rls": {}
}