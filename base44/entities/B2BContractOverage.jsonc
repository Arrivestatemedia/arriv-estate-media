{
  "name": "B2BContractOverage",
  "type": "object",
  "properties": {
    "overage_id": {
      "type": "string",
      "description": "Canonical overage ID (unique)"
    },
    "organization_id": {
      "type": "string"
    },
    "contract_id": {
      "type": "string"
    },
    "contract_version_id": {
      "type": "string",
      "description": "B2BContractVersion ID governing this overage"
    },
    "period_id": {
      "type": "string",
      "description": "B2BReservedCapacityPeriod or B2BMediaCreditPeriod ID where overage occurred"
    },
    "period_type": {
      "type": "string",
      "enum": [
        "capacity",
        "credit"
      ],
      "description": "Whether this overage is for a capacity period or credit period"
    },
    "booking_id": {
      "type": "string",
      "description": "Booking reference that triggered this overage (when available)"
    },
    "booking_reference": {
      "type": "string",
      "description": "External booking reference (when available)"
    },
    "overage_type": {
      "type": "string",
      "enum": [
        "capacity_overage",
        "credit_shortfall",
        "large_property_surcharge"
      ],
      "description": "Type of overage: capacity_overage = reserved shoots above contracted, credit_shortfall = credits consumed above available (split-tender cash obligation), large_property_surcharge = surcharge for >10K sqft properties"
    },
    "shoots_over": {
      "type": "integer",
      "description": "Number of shoots above contracted capacity (for capacity_overage)"
    },
    "quantity": {
      "type": "number",
      "description": "Quantity of the overage unit (credit units for credit_shortfall, shoots for capacity_overage)"
    },
    "contracted_per_shoot_rate": {
      "type": "number",
      "description": "Contracted effective per-shoot rate (dollars, for capacity_overage)"
    },
    "overage_rate_multiplier": {
      "type": "number",
      "description": "Overage multiplier (1.10)"
    },
    "overage_per_shoot_rate": {
      "type": "number",
      "description": "Overage per-shoot rate (contracted \u00d7 multiplier)"
    },
    "overage_amount": {
      "type": "number",
      "description": "Total overage charge (dollars)"
    },
    "unit_economics": {
      "type": "string",
      "description": "Human-readable description of the unit economics applied (e.g. '1 shoot \u00d7 $350 \u00d7 1.10 = $385')"
    },
    "locked_config_snapshot": {
      "type": "string",
      "description": "JSON reference to the locked contract-version config snapshot governing this overage"
    },
    "snapshot_json": {
      "type": "string",
      "description": "Immutable overage snapshot: contract terms, capacity/credit config, period, calculation"
    },
    "status": {
      "type": "string",
      "enum": [
        "created",
        "invoiced",
        "paid",
        "disputed",
        "waived"
      ],
      "default": "created"
    },
    "idempotency_key": {
      "type": "string",
      "description": "Idempotency key to prevent duplicate overage records"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "immutable_snapshot": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "overage_id",
    "organization_id",
    "contract_id",
    "overage_type",
    "overage_amount",
    "idempotency_key"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}