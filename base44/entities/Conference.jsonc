{
  "name": "Conference",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Conference title"
    },
    "description": {
      "type": "string",
      "description": "Conference description"
    },
    "scheduled_date": {
      "type": "string",
      "format": "date",
      "description": "Date of the conference"
    },
    "scheduled_time": {
      "type": "string",
      "description": "Time of the conference (HH:MM format)"
    },
    "duration_minutes": {
      "type": "integer",
      "default": 60,
      "description": "Duration in minutes"
    },
    "room_name": {
      "type": "string",
      "description": "Twilio video room name"
    },
    "meeting_link": {
      "type": "string",
      "description": "Direct link to join the conference"
    },
    "organizer_id": {
      "type": "string",
      "description": "Sales team member ID who created the conference"
    },
    "organizer_name": {
      "type": "string",
      "description": "Name of the organizer"
    },
    "organizer_email": {
      "type": "string",
      "description": "Email of the organizer"
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Participant ID"
          },
          "name": {
            "type": "string",
            "description": "Participant name"
          },
          "email": {
            "type": "string",
            "description": "Participant email"
          }
        }
      },
      "description": "List of invited participants"
    },
    "google_calendar_event_id": {
      "type": "string",
      "description": "Google Calendar event ID"
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "in_progress",
        "completed",
        "cancelled"
      ],
      "default": "scheduled",
      "description": "Conference status"
    },
    "channel_id": {
      "type": "string",
      "description": "Associated chat channel ID (optional)"
    },
    "round1_scorecard": {
      "type": "object",
      "description": "Round 1 general competency scorecard result (used when applicant is not synced to KhethaIQ)"
    },
    "scorecard_completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the scorecard was completed"
    },
    "interview_mode": {
      "type": "string",
      "enum": [
        "human",
        "ai"
      ],
      "default": "human",
      "description": "Interview mode: 'human' uses the existing Twilio Video room; 'ai' uses the Tavus CVI AI interviewer. Existing records default to 'human'."
    },
    "tavus_conversation_id": {
      "type": "string",
      "description": "Tavus CVI conversation ID (set when a Tavus conversation is created for an AI interview)"
    },
    "tavus_conversation_status": {
      "type": "string",
      "description": "Last known Tavus conversation status (active, ended, etc.)"
    },
    "tavus_started_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the Tavus AI interview was started"
    },
    "tavus_completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the Tavus AI interview was completed"
    },
    "tavus_meeting_token": {
      "type": "string",
      "description": "Tavus meeting token (required when require_auth=true; used to join the private conversation)"
    },
    "tavus_review_required": {
      "type": "boolean",
      "default": false,
      "description": "True when the Tavus transcript could not fully populate the questionnaire and requires human review"
    },
    "tavus_scorecard_saved": {
      "type": "boolean",
      "default": false,
      "description": "Whether the parsed Tavus transcript has been saved as a Round 1 scorecard"
    },
    "recording_url": {
      "type": "string",
      "description": "URL of the uploaded interview recording (local MediaRecorder upload to our storage)"
    },
    "recording_status": {
      "type": "string",
      "enum": [
        "none",
        "recording",
        "ready",
        "failed"
      ],
      "default": "none",
      "description": "Status of the local interview recording"
    },
    "recording_duration_seconds": {
      "type": "integer",
      "description": "Duration of the interview recording in seconds"
    },
    "tavus_recording_storage_uri": {
      "type": "string",
      "description": "Tavus server-side recording storage URI (from recording_ready webhook, backup recording for AI interviews)"
    },
    "twilio_room_sid": {
      "type": "string",
      "description": "Twilio Video room SID (set when the room is created with server-side recording enabled for human interviews)"
    },
    "twilio_composition_sid": {
      "type": "string",
      "description": "Twilio Composition SID (set when the composition is created after the room ends)"
    },
    "twilio_composition_url": {
      "type": "string",
      "description": "Twilio Composition media download URL (set when the composition is ready, backup recording for human interviews)"
    }
  },
  "required": [
    "title",
    "scheduled_date",
    "scheduled_time",
    "organizer_id",
    "organizer_email"
  ]
}