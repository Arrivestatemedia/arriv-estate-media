{
  "name": "B2BReservedCapacityPeriod",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "description": "B2BOrganization ID"
    },
    "contract_id": {
      "type": "string",
      "description": "B2BContract ID"
    },
    "contract_version_id": {
      "type": "string",
      "description": "B2BContractVersion ID \u2014 locked economics for this period"
    },
    "production_standard": {
      "type": "string",
      "enum": [
        "essentials",
        "cinematic",
        "premium"
      ],
      "description": "Production standard for this capacity period"
    },
    "contracted_shoots": {
      "type": "integer",
      "description": "Contracted reserved shoots for this period"
    },
    "available_shoots": {
      "type": "integer",
      "default": 0,
      "description": "Currently available (unreserved, unconsumed, unexpired) shoots"
    },
    "reserved_shoots": {
      "type": "integer",
      "default": 0,
      "description": "Currently reserved (pending booking confirmation) shoots"
    },
    "consumed_shoots": {
      "type": "integer",
      "default": 0,
      "description": "Consumed (committed) shoots"
    },
    "expired_shoots": {
      "type": "integer",
      "default": 0,
      "description": "Shoots expired at period end (no rollover)"
    },
    "adjusted_shoots": {
      "type": "integer",
      "default": 0,
      "description": "Net admin adjustments (positive or negative) in shoots"
    },
    "overage_shoots": {
      "type": "integer",
      "default": 0,
      "description": "Shoots consumed above contracted capacity this period (tracked separately)"
    },
    "used_shoots": {
      "type": "integer",
      "default": 0,
      "description": "Shoots consumed this period (display only \u2014 derived from consumed_shoots)"
    },
    "remaining_shoots": {
      "type": "integer",
      "description": "Remaining shoots (display only \u2014 derived from available_shoots)"
    },
    "has_unresolved_reservations": {
      "type": "boolean",
      "default": false,
      "description": "True when period expired with outstanding reserved shoots not yet reconciled"
    },
    "period_start": {
      "type": "string",
      "format": "date"
    },
    "period_end": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "expired",
        "closed"
      ],
      "default": "active"
    },
    "config_version": {
      "type": "string",
      "description": "B2BReservedCapacityConfig version at allocation time"
    },
    "allocation_ledger_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "organization_id",
    "contract_id",
    "production_standard",
    "contracted_shoots",
    "period_start",
    "period_end",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}