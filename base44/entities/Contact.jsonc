{
  "name": "Contact",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Canonical tenant ID for multi-tenant isolation",
      "default": "tnt_estate_media"
    },
    "sales_member_id": {
      "type": "string",
      "description": "ID of the sales team member who owns this contact (local SalesTeamMember ID, used for per-rep RLS isolation)"
    },
    "firstname": {
      "type": "string",
      "description": "First name"
    },
    "lastname": {
      "type": "string",
      "description": "Last name"
    },
    "email": {
      "type": "string",
      "description": "Email address"
    },
    "phone": {
      "type": "string",
      "description": "Phone number"
    },
    "company": {
      "type": "string",
      "description": "Company name"
    },
    "account_id": {
      "type": "string",
      "description": "Account ID this contact belongs to (links to Account entity for B2B company-level tracking)"
    },
    "job_title": {
      "type": "string",
      "description": "Job title"
    },
    "lead_status": {
      "type": "string",
      "description": "Lead status (NEW, OPEN, IN_PROGRESS, OPEN_DEAL, UNQUALIFIED, ATTEMPTED_TO_CONTACT, CONNECTED, BAD_TIMING)"
    },
    "lifecycle_stage": {
      "type": "string",
      "description": "Lifecycle stage (subscriber, lead, mql, sql, opportunity, customer)"
    },
    "owner_id": {
      "type": "string",
      "description": "ID of the sales rep who owns this contact"
    },
    "hubspot_id": {
      "type": "string",
      "description": "Original HubSpot contact ID (for migration mapping)"
    },
    "social_media": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Social media / profile URLs found for this contact"
    },
    "record_version": {
      "type": "integer",
      "default": 1,
      "description": "Monotonic record version for sync conflict detection"
    },
    "sync_source": {
      "type": "string",
      "enum": [
        "estate_media",
        "arriv_one"
      ],
      "description": "Which application last wrote this record via sync"
    },
    "origin_event_id": {
      "type": "string",
      "description": "Inbound event ID that caused the last sync write (loop prevention)"
    },
    "immutable_shared_id": {
      "type": "string",
      "description": "Immutable cross-app shared identifier"
    },
    "engagement_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Canonical Arriv One Customer360 engagement score (0-100). Arriv One-authoritative \u2014 Estate Media reads but never writes."
    },
    "relationship_age_days": {
      "type": "integer",
      "description": "Canonical relationship age in days since first contact. Arriv One-authoritative."
    },
    "communication_preferences": {
      "type": "string",
      "description": "Canonical communication preferences summary from Arriv One Customer360. Arriv One-authoritative."
    },
    "preferred_contact_method": {
      "type": "string",
      "enum": [
        "email",
        "phone",
        "text",
        "none"
      ],
      "description": "Canonical preferred contact method from Arriv One Customer360. Arriv One-authoritative."
    },
    "relationship_health": {
      "type": "string",
      "enum": [
        "healthy",
        "at_risk",
        "critical",
        "churned"
      ],
      "description": "Canonical relationship health from Arriv One Customer360. Arriv One-authoritative."
    },
    "churn_risk": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Canonical churn risk score (0-100) from Arriv One Customer360. Arriv One-authoritative."
    },
    "next_best_action": {
      "type": "string",
      "description": "Canonical recommended next best action from Arriv One Customer360 sales intelligence. Arriv One-authoritative."
    },
    "next_best_action_timing": {
      "type": "string",
      "description": "Canonical recommended outreach timing for the next best action. Arriv One-authoritative."
    },
    "upsell_opportunities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Canonical upsell opportunities from Arriv One Customer360 sales intelligence. Arriv One-authoritative."
    },
    "recommended_products": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Canonical recommended next products from Arriv One Customer360 sales intelligence. Arriv One-authoritative."
    },
    "sales_memory": {
      "type": "object",
      "properties": {
        "successful_approaches": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Sales approaches that worked previously with this customer"
        },
        "objections": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Known objections raised by this customer"
        },
        "decision_maker_preferences": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Decision-maker preferences and priorities"
        },
        "relationship_notes": {
          "type": "string",
          "description": "Historical relationship context notes"
        },
        "historical_context": {
          "type": "string",
          "description": "Historical selling context from Arriv One AI sales memory"
        }
      },
      "description": "Canonical AI sales memory from Arriv One Customer360. Arriv One-authoritative \u2014 Estate Media reads but never writes."
    },
    "recommendation_outcomes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "recommendation": {
            "type": "string",
            "description": "The recommendation that was made"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "converted",
              "not_converted",
              "pending"
            ],
            "description": "Whether the recommendation converted"
          },
          "date": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "description": "Canonical recommendation outcome history from Arriv One Customer360 learning. Arriv One-authoritative."
    },
    "recommendation_conversion_rate": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Canonical recommendation conversion rate (0-100) from Arriv One Customer360 learning. Arriv One-authoritative."
    },
    "what_worked_previously": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Canonical sales approach learning \u2014 what worked previously with this customer. Arriv One-authoritative."
    },
    "intelligence_synced_at": {
      "type": "string",
      "format": "date-time",
      "description": "When Arriv One last refreshed the Customer360 intelligence fields on this contact. Arriv One-authoritative."
    },
    "intelligence_version": {
      "type": "integer",
      "description": "Monotonic version for intelligence updates from Arriv One. Arriv One-authoritative."
    }
  },
  "required": [],
  "rls": {}
}