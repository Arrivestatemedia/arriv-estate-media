{
  "name": "InboundCall",
  "type": "object",
  "properties": {
    "call_sid": {
      "type": "string",
      "description": "Twilio CallSid. One record per call leg, so a redelivered webhook never creates a second record."
    },
    "from_number": {
      "type": "string"
    },
    "to_number": {
      "type": "string",
      "description": "The Arriv number the caller dialed (855 or 706)."
    },
    "caller_type": {
      "type": "string",
      "enum": [
        "owner",
        "media_specialist",
        "client",
        "b2b_client",
        "public",
        "unknown"
      ],
      "enumColors": [
        "purple",
        "blue",
        "green",
        "green",
        "gray",
        "gray"
      ],
      "default": "unknown"
    },
    "caller_name": {
      "type": "string"
    },
    "caller_email": {
      "type": "string"
    },
    "related_job_id": {
      "type": "string"
    },
    "related_signup_id": {
      "type": "string",
      "description": "Verified customer account (PendingSignup) the caller's number matched"
    },
    "related_contact_id": {
      "type": "string"
    },
    "related_organization_id": {
      "type": "string"
    },
    "route": {
      "type": "string",
      "description": "The path actually taken: admin_dialout, job_media_partner, job_client, media_specialist_menu, client_menu, public_menu, sales_ring, support_overflow, voicemail, callback, ashley, legacy_fallback, unknown",
      "default": "unknown"
    },
    "stage": {
      "type": "string",
      "description": "Current step inside the chosen route (for example sales_2 or ashley_booking)"
    },
    "menu_path": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Append-only trail of menus and digit selections"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "in_progress",
        "answered",
        "missed",
        "voicemail",
        "callback",
        "abandoned",
        "transferred"
      ],
      "enumColors": [
        "yellow",
        "green",
        "red",
        "blue",
        "purple",
        "gray",
        "blue"
      ],
      "default": "in_progress"
    },
    "dial_status": {
      "type": "string",
      "description": "Raw DialCallStatus reported by Twilio for the stage that ran"
    },
    "duration_seconds": {
      "type": "integer",
      "default": 0
    },
    "recording_sid": {
      "type": "string"
    },
    "ashley_draft": {
      "type": "object",
      "description": "Slots Ashley has collected for an in-progress booking or callback. Never a confirmed booking.",
      "properties": {
        "property_address": {
          "type": "string"
        },
        "package": {
          "type": "string"
        },
        "preferred_date": {
          "type": "string"
        },
        "preferred_time": {
          "type": "string"
        },
        "client_name": {
          "type": "string"
        },
        "client_email": {
          "type": "string"
        },
        "client_phone": {
          "type": "string"
        },
        "last_question": {
          "type": "string"
        }
      }
    },
    "ashley_turns": {
      "type": "integer",
      "default": 0
    },
    "booking_id": {
      "type": "string",
      "description": "Booking created by Ashley through the existing booking workflow"
    },
    "callback_id": {
      "type": "string"
    },
    "voicemail_id": {
      "type": "string"
    },
    "events": {
      "type": "array",
      "description": "Append-only audit trail for this call",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "call_sid",
    "from_number",
    "to_number"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}