{
  "name": "CallCenterSettings",
  "type": "object",
  "properties": {
    "settings_key": {
      "type": "string",
      "default": "default",
      "description": "Singleton key. Exactly one settings record drives the live telephone system."
    },
    "owner_caller_id": {
      "type": "string",
      "description": "Caller ID shown on every transfer to the owner, regardless of which Arriv number received the call. Empty means use TWILIO_CALLING_PHONE_NUMBER."
    },
    "owner_fallback_number": {
      "type": "string",
      "description": "Owner number used as the final human ring stage. Empty means OWNER_PHONE_NUMBER."
    },
    "sales_reps": {
      "type": "array",
      "description": "Eligible Growth Advisors for the sales ring group. Adding a representative is a settings change, never a code change.",
      "items": {
        "type": "object",
        "properties": {
          "sales_member_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "primary_number": {
            "type": "string",
            "description": "Stage 1 business number"
          },
          "cell_number": {
            "type": "string",
            "description": "Stage 2 cellphone number"
          },
          "eligible": {
            "type": "boolean",
            "default": true
          }
        }
      }
    },
    "stage_enabled": {
      "type": "object",
      "description": "Which ring stages are active.",
      "properties": {
        "primary": {
          "type": "boolean",
          "default": true
        },
        "cell": {
          "type": "boolean",
          "default": true
        },
        "owner": {
          "type": "boolean",
          "default": true
        },
        "ai": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "stage_timeouts": {
      "type": "object",
      "description": "Seconds to ring each stage before moving on.",
      "properties": {
        "primary": {
          "type": "integer",
          "default": 18
        },
        "cell": {
          "type": "integer",
          "default": 18
        },
        "owner": {
          "type": "integer",
          "default": 20
        }
      }
    },
    "support_destination_number": {
      "type": "string",
      "description": "Technical support destination. Empty means the owner fallback number."
    },
    "support_overflow_enabled": {
      "type": "boolean",
      "default": true,
      "description": "When true, support requests land in the overflow menu (callback or voicemail)."
    },
    "voicemail_enabled": {
      "type": "boolean",
      "default": true
    },
    "callback_enabled": {
      "type": "boolean",
      "default": true
    },
    "callback_assignment": {
      "type": "string",
      "enum": [
        "owner",
        "client_owner",
        "round_robin"
      ],
      "enumColors": [
        "blue",
        "purple",
        "gray"
      ],
      "default": "owner",
      "description": "How new callbacks are assigned. 'client_owner' uses the client's assigned Growth Advisor; 'round_robin' rotates eligible representatives."
    },
    "ai_booking_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Hand unanswered sales calls to Ashley, the AI booking concierge."
    },
    "greeting_overrides": {
      "type": "object",
      "description": "Optional replacement greeting text. An empty field keeps the approved default wording.",
      "properties": {
        "public": {
          "type": "string"
        },
        "support_overflow": {
          "type": "string"
        },
        "technical_message": {
          "type": "string"
        }
      }
    },
    "notifications": {
      "type": "object",
      "properties": {
        "owner_sms": {
          "type": "boolean",
          "default": true
        },
        "notification_number": {
          "type": "string",
          "description": "Receives call center SMS alerts. Empty means OWNER_PHONE_NUMBER."
        }
      }
    },
    "updated_by": {
      "type": "string"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "settings_key"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}