{
  "name": "Deal",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Tenant ID for multi-tenant isolation",
      "default": "tnt_estate_media"
    },
    "sales_member_id": {
      "type": "string",
      "description": "SalesTeamMember ID of the rep who owns this deal"
    },
    "contact_id": {
      "type": "string",
      "description": "Contact ID this deal is associated with"
    },
    "contact_name": {
      "type": "string",
      "description": "Contact name (denormalized)"
    },
    "contact_email": {
      "type": "string",
      "description": "Contact email (denormalized)"
    },
    "title": {
      "type": "string",
      "description": "Deal title or summary"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "won",
        "lost",
        "paid"
      ],
      "default": "open",
      "description": "Deal stage / outcome"
    },
    "contract_value": {
      "type": "number",
      "default": 0,
      "description": "Total contract value"
    },
    "amount_collected": {
      "type": "number",
      "default": 0,
      "description": "Amount actually collected"
    },
    "service_address": {
      "type": "string",
      "description": "Service property address (used for market extraction)"
    },
    "company": {
      "type": "string",
      "description": "Company or brokerage name"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Deal creation timestamp"
    },
    "closed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the deal was closed (won/lost/paid)"
    },
    "notes": {
      "type": "string",
      "description": "Deal notes"
    },
    "record_version": {
      "type": "integer",
      "default": 1,
      "description": "Monotonic record version for sync conflict detection"
    },
    "sync_source": {
      "type": "string",
      "enum": [
        "estate_media",
        "arriv_one"
      ],
      "description": "Which application last wrote this record via sync"
    },
    "origin_event_id": {
      "type": "string",
      "description": "Inbound event ID that caused the last sync write (loop prevention)"
    },
    "immutable_shared_id": {
      "type": "string",
      "description": "Immutable cross-app shared identifier"
    }
  },
  "required": [
    "sales_member_id",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}