{
  "name": "B2BMediaCreditLedger",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "description": "B2BOrganization ID"
    },
    "contract_id": {
      "type": "string",
      "description": "B2BContract ID"
    },
    "contract_version_id": {
      "type": "string",
      "description": "B2BContractVersion ID governing this event"
    },
    "period_id": {
      "type": "string",
      "description": "B2BMediaCreditPeriod ID"
    },
    "booking_id": {
      "type": "string",
      "description": "Associated booking ID (if applicable)"
    },
    "booking_reference": {
      "type": "string",
      "description": "External booking reference (if applicable)"
    },
    "reservation_id": {
      "type": "string",
      "description": "Reservation ID linking RESERVATION, RESERVATION_RELEASE, and BOOKING_CONSUMPTION events"
    },
    "original_event_id": {
      "type": "string",
      "description": "ID of the original ledger event this entry reverses or compensates (for reversals)"
    },
    "amount": {
      "type": "number",
      "description": "Credit amount (display only \u2014 derived from amount_units)"
    },
    "amount_units": {
      "type": "integer",
      "description": "Credit amount in integer units (1 credit = 100 units). Positive for allocation/reversal, negative for consumption/expiration."
    },
    "balance_before_units": {
      "type": "integer",
      "description": "Available credit balance (units) before this event"
    },
    "balance_after_units": {
      "type": "integer",
      "description": "Available credit balance (units) after this event"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "PERIOD_ALLOCATION",
        "RESERVATION",
        "RESERVATION_RELEASE",
        "BOOKING_CONSUMPTION",
        "ADDON_CONSUMPTION",
        "BOOKING_REVERSAL",
        "EXPIRATION",
        "ADMIN_ADJUSTMENT",
        "CONTRACT_CHANGE",
        "MIGRATION"
      ],
      "description": "Credit ledger event type"
    },
    "reason": {
      "type": "string",
      "description": "Human-readable reason for this event"
    },
    "actor": {
      "type": "string",
      "description": "User/system that caused this event"
    },
    "acting_user_id": {
      "type": "string",
      "description": "B2BOrganizationMember user_id of the acting member (for booking operations)"
    },
    "organization_member_id": {
      "type": "string",
      "description": "B2BOrganizationMember ID of the acting member"
    },
    "config_version": {
      "type": "string",
      "description": "B2BMediaCreditConfig version at event time"
    },
    "idempotency_key": {
      "type": "string",
      "description": "Idempotency key to prevent double consumption on retry"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "organization_id",
    "contract_id",
    "amount_units",
    "event_type",
    "idempotency_key"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}