{
  "name": "CreditLot",
  "type": "object",
  "properties": {
    "wallet_id": {
      "type": "string",
      "description": "PrepaidWallet ID this lot belongs to"
    },
    "customer_id": {
      "type": "string",
      "description": "Customer 360 ID (denormalized for lookups)"
    },
    "customer_email": {
      "type": "string",
      "description": "Denormalized for RLS"
    },
    "lot_id": {
      "type": "string",
      "description": "Stable lot identifier (globally unique)"
    },
    "source": {
      "type": "string",
      "enum": [
        "purchase",
        "reload",
        "admin_adjustment",
        "promotional"
      ]
    },
    "source_transaction_id": {
      "type": "string",
      "description": "WalletTransaction ID that created this lot"
    },
    "tier": {
      "type": "string",
      "enum": [
        "STARTER",
        "PRO",
        "PREMIER",
        "ELITE"
      ],
      "description": "Tier of the purchase/reload that created this lot"
    },
    "credits_issued": {
      "type": "number",
      "description": "Original credits in this lot. Display only \u2014 derived from booking_value_issued_cents."
    },
    "credits_remaining": {
      "type": "number",
      "default": 0,
      "description": "Unconsumed credits remaining. Display only \u2014 derived from booking_value_remaining_cents."
    },
    "booking_value_issued": {
      "type": "number",
      "description": "Original booking value (display). Derived from booking_value_issued_cents."
    },
    "booking_value_remaining": {
      "type": "number",
      "default": 0,
      "description": "Remaining booking value (display). Derived from booking_value_remaining_cents."
    },
    "booking_value_issued_cents": {
      "type": "integer",
      "description": "Original booking value in integer cents. Authoritative \u2014 no floating-point loss."
    },
    "booking_value_remaining_cents": {
      "type": "integer",
      "default": 0,
      "description": "Remaining booking value in integer cents. Authoritative for FIFO and expiration. A dispute hold does NOT change this value \u2014 the held amount is removed from the wallet's spendable balance instead, so releasing a hold restores the exact amount without reconstructing the lot."
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this lot expires. Independent per lot."
    },
    "expired": {
      "type": "boolean",
      "default": false
    },
    "expired_at": {
      "type": "string",
      "format": "date-time"
    },
    "fifo_order": {
      "type": "integer",
      "description": "Monotonic order for FIFO consumption (oldest first)"
    },
    "stripe_transaction_id": {
      "type": "string",
      "description": "Associated Stripe payment ID (if applicable). Used to trace a disputed charge to the exact lot it funded."
    },
    "dispute_hold": {
      "type": "boolean",
      "default": false,
      "description": "True while this lot's unspent value is suspended by an open dispute. A held lot is excluded from the wallet's spendable balance and from FIFO consumption, so it cannot be redeemed, but it is never deleted or rewritten."
    },
    "dispute_hold_cents": {
      "type": "integer",
      "default": 0,
      "description": "Amount of THIS lot suspended by the open dispute, in integer cents. Zero when no hold is active."
    },
    "dispute_hold_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the hold was applied"
    },
    "dispute_hold_reason": {
      "type": "string",
      "description": "Why the lot is held (e.g. CHARGEBACK_OPEN)"
    },
    "dispute_reference": {
      "type": "string",
      "description": "Provider dispute/chargeback reference that caused the hold. Links the lot to its AutoFundDisputeCase."
    },
    "dispute_hold_released_at": {
      "type": "string",
      "format": "date-time",
      "description": "When a hold on this lot was released because the dispute was resolved in the customer's favour"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "wallet_id",
    "customer_id",
    "lot_id",
    "source",
    "credits_issued",
    "expires_at"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}