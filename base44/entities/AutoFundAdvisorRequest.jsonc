{
  "name": "AutoFundAdvisorRequest",
  "type": "object",
  "properties": {
    "request_id": {
      "type": "string",
      "description": "Stable request identifier (afadv_...)."
    },
    "customer_email": {
      "type": "string",
      "description": "Email of the signed-in customer who asked to speak with a Sales Growth Advisor."
    },
    "customer_name": {
      "type": "string"
    },
    "customer_phone": {
      "type": "string"
    },
    "preferred_time": {
      "type": "string",
      "description": "When the customer prefers to be contacted."
    },
    "notes": {
      "type": "string",
      "description": "Anything the customer wants the advisor to know."
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "contacted",
        "closed"
      ],
      "default": "new",
      "description": "Advisor follow-up status."
    },
    "handled_by_email": {
      "type": "string",
      "description": "Advisor who handled this request."
    },
    "handled_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string",
      "default": "autofund_self_service",
      "description": "Where the request originated."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "request_id",
    "customer_email",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}