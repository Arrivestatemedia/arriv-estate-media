{
  "name": "ScheduledEmail",
  "type": "object",
  "properties": {
    "sales_member_id": {
      "type": "string",
      "description": "ID of the sales rep who scheduled"
    },
    "sales_member_email": {
      "type": "string",
      "description": "Email of the sales rep"
    },
    "to": {
      "type": "string",
      "description": "Recipient email"
    },
    "subject": {
      "type": "string",
      "description": "Email subject"
    },
    "body": {
      "type": "string",
      "description": "Email body"
    },
    "from_email": {
      "type": "string",
      "description": "Send from address"
    },
    "from_name": {
      "type": "string",
      "description": "Send from name"
    },
    "scheduled_for": {
      "type": "string",
      "format": "date-time",
      "description": "When to send the email"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "submitted",
        "sent",
        "failed"
      ],
      "default": "pending",
      "description": "Submitted means accepted by Brevo; sent requires delivery confirmation for receipt-tracked emails. Legacy sent rows may have no receipt."
    },
    "provider_message_id": {
      "type": "string",
      "description": "Brevo message receipt. An existing receipt prevents automatic resending."
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time",
      "description": "When Brevo accepted the sending request"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "Confirmed delivery time for receipt-tracked emails; legacy rows used submission time"
    },
    "error_message": {
      "type": "string",
      "description": "Error if failed"
    }
  },
  "required": [
    "to",
    "subject",
    "body",
    "scheduled_for"
  ]
}