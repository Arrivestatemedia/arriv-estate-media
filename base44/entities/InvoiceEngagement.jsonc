{
  "name": "InvoiceEngagement",
  "type": "object",
  "properties": {
    "invoice_id": {
      "type": "string",
      "description": "Invoice row the client interacted with"
    },
    "invoice_number": {
      "type": "string",
      "description": "Human-readable invoice number, denormalized for the log"
    },
    "invoice_type": {
      "type": "string",
      "description": "Invoice type at the time of the click"
    },
    "client_email": {
      "type": "string",
      "description": "Client the invoice belongs to"
    },
    "client_name": {
      "type": "string"
    },
    "job_address": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "action": {
      "type": "string",
      "enum": [
        "pay",
        "view_invoice",
        "view_receipt"
      ],
      "description": "Which link the client opened from their portal"
    },
    "clicked_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the client opened the link"
    },
    "sms_sent": {
      "type": "boolean",
      "default": false,
      "description": "Whether this click triggered an owner notification text"
    },
    "sms_recipient": {
      "type": "string",
      "description": "Owner number the notification was sent to"
    }
  },
  "required": [
    "invoice_id",
    "client_email",
    "action",
    "clicked_at"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}