{
  "name": "SalesTeamMember",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "description": "Sales team member email (login)"
    },
    "company_email": {
      "type": "string",
      "description": "Company email address to send emails from (e.g. john@arriv.com)"
    },
    "full_name": {
      "type": "string",
      "description": "Full name of sales team member"
    },
    "title": {
      "type": "string",
      "description": "Job title (e.g. Sales Representative)"
    },
    "phone_number": {
      "type": "string",
      "description": "Personal cell phone number"
    },
    "work_phone": {
      "type": "string",
      "description": "Work phone number"
    },
    "twilio_phone_number": {
      "type": "string",
      "description": "Assigned Twilio phone number for this rep (e.g. +15551234567)"
    },
    "extension": {
      "type": "integer",
      "description": "Internal extension (100-999)",
      "minimum": 100,
      "maximum": 999
    },
    "password_hash": {
      "type": "string",
      "description": "Hashed password"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether sales team member can log in"
    },
    "force_password_change": {
      "type": "boolean",
      "default": false,
      "description": "Whether sales rep must change password on next login"
    },
    "profile_picture_url": {
      "type": "string",
      "description": "URL of the rep's profile picture"
    },
    "chat_status": {
      "type": "string",
      "enum": [
        "online",
        "available",
        "busy",
        "in_meeting",
        "away",
        "lunch",
        "break",
        "offline"
      ],
      "default": "online",
      "description": "Current chat status"
    },
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user",
      "description": "Role of the sales team member"
    },
    "payroll_employee_id": {
      "type": "string",
      "description": "Arriv Payroll employee ID mapping for this sales team member"
    },
    "payroll_sync_status": {
      "type": "string",
      "enum": [
        "not_synced",
        "syncing",
        "synced",
        "error"
      ],
      "default": "not_synced",
      "description": "Payroll employee mapping synchronization status"
    },
    "payroll_last_synced_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this employee was last synced to Arriv Payroll"
    },
    "payroll_sync_error": {
      "type": "string",
      "description": "Last payroll mapping sync error, if any"
    },
    "arriv_employee_id": {
      "type": "string",
      "description": "Immutable ARRIV_EMPLOYEE_ID \u2014 primary cross-system identifier. Assigned once at activation and never changed."
    },
    "legal_first_name": {
      "type": "string",
      "description": "Legal first name"
    },
    "legal_middle_name": {
      "type": "string",
      "description": "Legal middle name (when provided)"
    },
    "legal_last_name": {
      "type": "string",
      "description": "Legal last name"
    },
    "preferred_name": {
      "type": "string",
      "description": "Preferred name"
    },
    "personal_email": {
      "type": "string",
      "description": "Personal email address"
    },
    "mobile_phone_number": {
      "type": "string",
      "description": "Mobile phone number (synced to payroll)"
    },
    "home_address": {
      "type": "string",
      "description": "Home street address"
    },
    "employee_city": {
      "type": "string",
      "description": "Home city"
    },
    "employee_state": {
      "type": "string",
      "description": "Home state"
    },
    "employee_zip": {
      "type": "string",
      "description": "Home ZIP code"
    },
    "employee_country": {
      "type": "string",
      "default": "US",
      "description": "Home country (ISO code)"
    },
    "employment_classification": {
      "type": "string",
      "enum": [
        "w2_employee",
        "contractor",
        "part_time",
        "terminated"
      ],
      "default": "w2_employee",
      "description": "Employment classification"
    },
    "employment_status": {
      "type": "string",
      "enum": [
        "pending_offer",
        "offer_accepted",
        "active",
        "on_leave",
        "terminated"
      ],
      "default": "pending_offer",
      "description": "Employment status"
    },
    "original_hire_date": {
      "type": "string",
      "format": "date",
      "description": "Original hire date"
    },
    "current_effective_hire_date": {
      "type": "string",
      "format": "date",
      "description": "Current effective hire date"
    },
    "termination_date": {
      "type": "string",
      "format": "date",
      "description": "Termination date, when applicable"
    },
    "payroll_eligible": {
      "type": "boolean",
      "default": false,
      "description": "Whether the employee is eligible for payroll"
    },
    "compensation_type": {
      "type": "string",
      "enum": [
        "commission_only",
        "base_plus_commission",
        "salary"
      ],
      "default": "commission_only",
      "description": "Compensation type"
    },
    "commission_plan_id": {
      "type": "string",
      "description": "Assigned CommissionPlan plan_id"
    },
    "commission_plan_version": {
      "type": "integer",
      "description": "Commission plan version assigned to the employee"
    },
    "commission_rate": {
      "type": "number",
      "description": "Commission rate (decimal) \u2014 snapshot of the plan rate at assignment"
    },
    "commission_effective_date": {
      "type": "string",
      "format": "date",
      "description": "Date the current commission rate/plan became effective for this employee"
    },
    "manager_id": {
      "type": "string",
      "description": "Manager ARRIV_EMPLOYEE_ID or system ID"
    },
    "work_state": {
      "type": "string",
      "description": "Work state (for tax/work location)"
    },
    "primary_work_location": {
      "type": "string",
      "description": "Primary work location label"
    },
    "department": {
      "type": "string",
      "default": "Sales",
      "description": "Department"
    },
    "stripe_account_id": {
      "type": "string",
      "description": "Stripe connected account ID, when available"
    },
    "stripe_onboarding_status": {
      "type": "string",
      "enum": [
        "not_started",
        "in_progress",
        "complete",
        "incomplete"
      ],
      "default": "not_started",
      "description": "Stripe onboarding status"
    },
    "stripe_payouts_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether Stripe payouts are enabled"
    },
    "source_record_version": {
      "type": "integer",
      "default": 1,
      "description": "Employee record version, incremented on every sync-triggering change"
    },
    "last_successful_sync_timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Last successful synchronization timestamp with Arriv Payroll"
    }
  },
  "required": [
    "email",
    "full_name",
    "password_hash"
  ]
}