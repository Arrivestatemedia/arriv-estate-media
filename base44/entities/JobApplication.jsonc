{
  "name": "JobApplication",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Multi-tenant isolation key",
      "default": "tnt_estate_media"
    },
    "full_name": {
      "type": "string",
      "description": "Applicant's full name"
    },
    "email": {
      "type": "string",
      "description": "Applicant's email"
    },
    "phone": {
      "type": "string",
      "description": "Applicant's phone number"
    },
    "address": {
      "type": "string",
      "description": "Applicant's address"
    },
    "dob": {
      "type": "string",
      "format": "date",
      "description": "Applicant's date of birth"
    },
    "linkedin": {
      "type": "string",
      "description": "LinkedIn profile URL"
    },
    "portfolio_link": {
      "type": "string",
      "description": "Portfolio website URL"
    },
    "last_related_job": {
      "type": "string",
      "description": "Description of last related job/experience"
    },
    "why_good_fit": {
      "type": "string",
      "description": "Why applicant believes they are a good fit"
    },
    "race": {
      "type": "string",
      "enum": [
        "white",
        "black_african_american",
        "hispanic_latino",
        "asian",
        "native_american",
        "pacific_islander",
        "two_or_more",
        "prefer_not_to_answer"
      ],
      "description": "Applicant's race/ethnicity (EEOC) \u2014 NEVER sync to external systems"
    },
    "eeoc_agreed": {
      "type": "boolean",
      "description": "Applicant acknowledges EEOC notice",
      "default": false
    },
    "signature": {
      "type": "string",
      "description": "Applicant's electronic signature (typed full name) \u2014 NEVER sync to external systems"
    },
    "video_samples": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Google Drive URLs of video samples \u2014 NEVER sync to external systems"
    },
    "picture_samples": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Google Drive URLs of picture samples \u2014 NEVER sync to external systems"
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Additional document links the applicant uploaded (resume URL stored here)"
    },
    "position": {
      "type": "string",
      "enum": [
        "media_specialist",
        "sales_growth_advisor",
        "general"
      ],
      "default": "media_specialist",
      "description": "Which role the applicant applied for"
    },
    "job_id": {
      "type": "string",
      "description": "HireJob ID this application is for (if created from a Khetha IQ job posting)"
    },
    "job_opening_id": {
      "type": "string",
      "description": "JobOpening.job_id this application was submitted for (public careers flow)"
    },
    "hire_candidate_id": {
      "type": "string",
      "description": "KhethaIQ HireCandidate ID this application was synced to"
    },
    "shared_person_id": {
      "type": "string",
      "description": "Cross-system person identifier linking this application to KhethaIQ and Estate Media records"
    },
    "source": {
      "type": "string",
      "enum": [
        "standalone",
        "arriv_one",
        "arriv_estate_media"
      ],
      "default": "arriv_estate_media",
      "description": "Which application originated this record"
    },
    "application_source": {
      "type": "string",
      "enum": [
        "direct",
        "indeed",
        "linkedin",
        "handshake",
        "facebook",
        "x",
        "email",
        "qr_code",
        "company_website",
        "employee_referral",
        "other",
        "unknown"
      ],
      "default": "unknown",
      "description": "Server-authoritative source attribution (normalized server-side, never trust raw client input)"
    },
    "application_source_detail": {
      "type": "string",
      "description": "Additional detail about the application source"
    },
    "utm_source": {
      "type": "string"
    },
    "utm_medium": {
      "type": "string"
    },
    "utm_campaign": {
      "type": "string"
    },
    "utm_content": {
      "type": "string"
    },
    "referrer_url": {
      "type": "string",
      "description": "Referrer URL (max 500 chars)"
    },
    "landing_page_url": {
      "type": "string",
      "description": "Landing page URL (max 500 chars)"
    },
    "first_touch_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the applicant first touched the landing page"
    },
    "application_started_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the applicant started the application form"
    },
    "application_submitted_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the application was submitted"
    },
    "origin_application": {
      "type": "string",
      "enum": [
        "khethaiq",
        "arriv_one",
        "arriv_estate_media",
        "system"
      ],
      "default": "arriv_estate_media",
      "description": "Provenance for loop suppression"
    },
    "origin_event_id": {
      "type": "string",
      "description": "Idempotency event ID from the webhook"
    },
    "status": {
      "type": "string",
      "enum": [
        "received",
        "reviewing",
        "accepted_pending",
        "accepted",
        "accepted_waitlist",
        "denied",
        "under_review",
        "interview_invitation",
        "final_review",
        "offer_extended",
        "hired",
        "offer_not_extended"
      ],
      "default": "received",
      "description": "Application status"
    },
    "updates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "Update message shown to the applicant"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "When the update was posted"
          }
        }
      },
      "description": "Admin-posted updates visible to the applicant"
    },
    "documents_requested": {
      "type": "boolean",
      "default": false,
      "description": "Whether the admin requested additional documents"
    },
    "documents_requested_note": {
      "type": "string",
      "description": "Note describing what documents are needed"
    },
    "portal_viewed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the applicant last viewed their portal"
    },
    "portal_view_count": {
      "type": "integer",
      "default": 0,
      "description": "How many times the applicant has looked up their application in the portal"
    },
    "offer_extended_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the offer was extended to the applicant"
    },
    "offer_accepted_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the applicant accepted their offer (sales growth advisor)"
    },
    "offer_declined_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the applicant declined their offer (sales growth advisor)"
    },
    "archived": {
      "type": "boolean",
      "default": false,
      "description": "Whether this application has been archived after closure (denied or offer not extended)"
    }
  },
  "required": [
    "full_name",
    "email",
    "phone"
  ]
}