{
  "name": "JobApplication",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Multi-tenant isolation key",
      "default": "tnt_estate_media"
    },
    "full_name": {
      "type": "string",
      "description": "Applicant's full name"
    },
    "email": {
      "type": "string",
      "description": "Applicant's email"
    },
    "phone": {
      "type": "string",
      "description": "Applicant's phone number"
    },
    "address": {
      "type": "string",
      "description": "Applicant's residential address"
    },
    "dob": {
      "type": "string",
      "format": "date",
      "description": "Applicant's date of birth, as supplied by the applicant. Never inferred from a r\u00e9sum\u00e9."
    },
    "linkedin": {
      "type": "string",
      "description": "LinkedIn profile URL"
    },
    "portfolio_link": {
      "type": "string",
      "description": "Portfolio or r\u00e9sum\u00e9 reference for this applicant"
    },
    "last_related_job": {
      "type": "string",
      "description": "Description of last related job/experience"
    },
    "why_good_fit": {
      "type": "string",
      "description": "Why applicant believes they are a good fit"
    },
    "race": {
      "type": "string",
      "enum": [
        "white",
        "black_african_american",
        "hispanic_latino",
        "asian",
        "native_american",
        "pacific_islander",
        "two_or_more",
        "prefer_not_to_answer"
      ],
      "description": "Applicant's race/ethnicity (EEOC) \u2014 NEVER sync to external systems"
    },
    "eeoc_agreed": {
      "type": "boolean",
      "description": "Applicant acknowledges EEOC notice",
      "default": false
    },
    "signature": {
      "type": "string",
      "description": "Applicant's electronic signature (typed full name) \u2014 NEVER sync to external systems"
    },
    "video_samples": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Google Drive URLs of video samples \u2014 NEVER sync to external systems"
    },
    "picture_samples": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Google Drive URLs of picture samples \u2014 NEVER sync to external systems"
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Additional document links the applicant uploaded (r\u00e9sum\u00e9 URL stored here)"
    },
    "position": {
      "type": "string",
      "enum": [
        "media_specialist",
        "sales_growth_advisor",
        "general"
      ],
      "default": "media_specialist",
      "description": "Which role the applicant applied for"
    },
    "job_id": {
      "type": "string",
      "description": "HireJob ID this application is for"
    },
    "job_opening_id": {
      "type": "string",
      "description": "JobOpening.job_id this application was submitted for"
    },
    "hire_candidate_id": {
      "type": "string",
      "description": "KhethaIQ HireCandidate ID this application was synced to"
    },
    "shared_person_id": {
      "type": "string",
      "description": "Cross-system person identifier"
    },
    "source": {
      "type": "string",
      "enum": [
        "standalone",
        "arriv_one",
        "arriv_estate_media"
      ],
      "default": "arriv_estate_media",
      "description": "Which application originated this record"
    },
    "application_source": {
      "type": "string",
      "enum": [
        "direct",
        "indeed",
        "linkedin",
        "handshake",
        "facebook",
        "x",
        "email",
        "qr_code",
        "company_website",
        "employee_referral",
        "other",
        "unknown"
      ],
      "default": "unknown",
      "description": "Server-authoritative source attribution"
    },
    "application_source_detail": {
      "type": "string",
      "description": "Additional detail about the application source"
    },
    "utm_source": {
      "type": "string"
    },
    "utm_medium": {
      "type": "string"
    },
    "utm_campaign": {
      "type": "string"
    },
    "utm_content": {
      "type": "string"
    },
    "referrer_url": {
      "type": "string",
      "description": "Referrer URL (max 500 chars)"
    },
    "landing_page_url": {
      "type": "string",
      "description": "Landing page URL (max 500 chars)"
    },
    "first_touch_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the applicant first touched the landing page"
    },
    "application_started_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the applicant started the application form"
    },
    "application_submitted_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the application was submitted"
    },
    "origin_application": {
      "type": "string",
      "enum": [
        "khethaiq",
        "arriv_one",
        "arriv_estate_media",
        "system"
      ],
      "default": "arriv_estate_media",
      "description": "Provenance for loop suppression"
    },
    "origin_event_id": {
      "type": "string",
      "description": "Idempotency event ID from the webhook"
    },
    "status": {
      "type": "string",
      "enum": [
        "received",
        "reviewing",
        "accepted_pending",
        "accepted",
        "accepted_waitlist",
        "denied",
        "under_review",
        "interview_invitation",
        "final_review",
        "offer_extended",
        "hired",
        "offer_not_extended"
      ],
      "default": "received",
      "description": "Application status"
    },
    "interview_invitation_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the admin sent the interview invitation (the status transitioned to interview_invitation). The authoritative clock for the stale-applicant auto-archive rule \u2014 measures from the invitation date, not the submission date. Empty for legacy records invited before this field existed; those fall back to created_date."
    },
    "updates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "description": "Admin-posted updates visible to the applicant"
    },
    "documents_requested": {
      "type": "boolean",
      "default": false,
      "description": "Whether the admin requested additional documents"
    },
    "documents_requested_note": {
      "type": "string",
      "description": "Note describing what documents are needed"
    },
    "portal_viewed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the applicant last viewed their portal"
    },
    "portal_view_count": {
      "type": "integer",
      "default": 0,
      "description": "How many times the applicant has looked up their application"
    },
    "offer_extended_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the offer was extended"
    },
    "offer_accepted_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the applicant accepted their offer"
    },
    "offer_declined_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the applicant declined their offer"
    },
    "archived": {
      "type": "boolean",
      "default": false,
      "description": "Whether this application has been archived after closure"
    },
    "imported_from_indeed": {
      "type": "boolean",
      "default": false,
      "description": "True when an administrator imported this applicant's r\u00e9sum\u00e9 from Indeed. The record is the same applicant record that the public application would create \u2014 it is not a separate recruiting system."
    },
    "profile_completion_status": {
      "type": "string",
      "enum": [
        "",
        "awaiting_profile_completion",
        "completed"
      ],
      "default": "",
      "description": "Careers Profile progress for an imported applicant. 'awaiting_profile_completion' means the r\u00e9sum\u00e9 was imported but the applicant has not completed their personalized profile yet; 'completed' means the applicant submitted it. Empty for applications that arrived through the public application form."
    },
    "profile_completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the applicant completed and submitted their personalized Careers Profile"
    },
    "resume_file_name": {
      "type": "string",
      "description": "File name of the imported r\u00e9sum\u00e9, shown to the applicant and the administrator"
    },
    "resume_extract": {
      "type": "object",
      "description": "Information read from the imported r\u00e9sum\u00e9, held for confirmation rather than invented. Only values actually present in the r\u00e9sum\u00e9 are ever stored; anything uncertain is listed in uncertain_fields for the applicant to confirm.",
      "properties": {
        "summary": {
          "type": "string"
        },
        "work_history": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "education": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "certifications": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "uncertain_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "extracted_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "careers_profile_token": {
      "type": "string",
      "description": "Opaque, unguessable token for the applicant's personalized Careers Profile link. It carries no applicant information and no record id. Regenerating replaces it, which invalidates the previous link."
    },
    "careers_profile_token_created_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the current personalized link was created"
    },
    "careers_profile_token_expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the current personalized link stops working"
    },
    "careers_profile_link_revoked_at": {
      "type": "string",
      "format": "date-time",
      "description": "When an administrator revoked the personalized link. A revoked link is refused immediately."
    },
    "admin_sms_notified_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the existing admin new-application SMS was successfully sent for this application. Written only after the applicant actually completes their Careers Profile, and read before every send so the same application can never notify twice."
    }
  },
  "required": [
    "full_name",
    "email",
    "phone"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}