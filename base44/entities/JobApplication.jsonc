{
  "name": "JobApplication",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string",
      "description": "Applicant's full name"
    },
    "email": {
      "type": "string",
      "description": "Applicant's email"
    },
    "phone": {
      "type": "string",
      "description": "Applicant's phone number"
    },
    "address": {
      "type": "string",
      "description": "Applicant's address"
    },
    "dob": {
      "type": "string",
      "format": "date",
      "description": "Applicant's date of birth"
    },
    "linkedin": {
      "type": "string",
      "description": "LinkedIn profile URL"
    },
    "portfolio_link": {
      "type": "string",
      "description": "Portfolio website URL"
    },
    "last_related_job": {
      "type": "string",
      "description": "Description of last related job/experience"
    },
    "why_good_fit": {
      "type": "string",
      "description": "Why applicant believes they are a good fit"
    },
    "race": {
      "type": "string",
      "enum": [
        "white",
        "black_african_american",
        "hispanic_latino",
        "asian",
        "native_american",
        "pacific_islander",
        "two_or_more",
        "prefer_not_to_answer"
      ],
      "description": "Applicant's race/ethnicity (EEOC)"
    },
    "eeoc_agreed": {
      "type": "boolean",
      "description": "Applicant acknowledges EEOC notice",
      "default": false
    },
    "signature": {
      "type": "string",
      "description": "Applicant's electronic signature (typed full name)"
    },
    "video_samples": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Google Drive URLs of video samples"
    },
    "picture_samples": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Google Drive URLs of picture samples"
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Additional document links the applicant uploaded"
    },
    "position": {
      "type": "string",
      "enum": [
        "media_specialist",
        "sales_growth_advisor"
      ],
      "default": "media_specialist",
      "description": "Which role the applicant applied for"
    },
    "status": {
      "type": "string",
      "enum": [
        "received",
        "reviewing",
        "accepted",
        "accepted_waitlist",
        "denied",
        "under_review",
        "interview_invitation",
        "final_review",
        "offer_extended",
        "hired",
        "offer_not_extended"
      ],
      "default": "received",
      "description": "Application status (media specialist uses received/reviewing/accepted/accepted_waitlist/denied; sales growth advisor uses received/under_review/interview_invitation/final_review/offer_extended/hired/offer_not_extended)"
    },
    "updates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "Update message shown to the applicant"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "When the update was posted"
          }
        }
      },
      "description": "Admin-posted updates visible to the applicant"
    },
    "documents_requested": {
      "type": "boolean",
      "default": false,
      "description": "Whether the admin requested additional documents"
    },
    "documents_requested_note": {
      "type": "string",
      "description": "Note describing what documents are needed"
    },
    "portal_viewed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the applicant last viewed their portal"
    },
    "portal_view_count": {
      "type": "integer",
      "default": 0,
      "description": "How many times the applicant has looked up their application in the portal"
    },
    "offer_extended_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the offer was extended to the applicant"
    },
    "offer_accepted_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the applicant accepted their offer (sales growth advisor)"
    },
    "offer_declined_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the applicant declined their offer (sales growth advisor)"
    }
  },
  "required": [
    "full_name",
    "email",
    "phone",
    "address",
    "dob",
    "linkedin",
    "portfolio_link",
    "last_related_job",
    "why_good_fit",
    "eeoc_agreed",
    "signature"
  ]
}