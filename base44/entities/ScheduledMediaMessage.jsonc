{
  "name": "ScheduledMediaMessage",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Template name (e.g. 'Standard Delivery')"
    },
    "body": {
      "type": "string",
      "description": "Message body. Use {first_name}, {address}, {drive_link}, {youtube_link} as placeholders."
    }
  },
  "required": [
    "name",
    "body"
  ]
}