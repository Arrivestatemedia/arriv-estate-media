{
  "name": "VoicemailMessage",
  "type": "object",
  "properties": {
    "voicemail_id": {
      "type": "string",
      "description": "Stable id (vm_...)"
    },
    "recording_sid": {
      "type": "string",
      "description": "Twilio RecordingSid. Unique: one recording never produces two voicemail records."
    },
    "recording_url": {
      "type": "string",
      "description": "Twilio recording URL. Never served directly to a browser; playback goes through the admin-gated call center endpoint."
    },
    "recording_duration": {
      "type": "integer",
      "default": 0
    },
    "call_sid": {
      "type": "string"
    },
    "from_number": {
      "type": "string"
    },
    "received_on_number": {
      "type": "string",
      "description": "Which Arriv number the caller dialed"
    },
    "caller_name": {
      "type": "string"
    },
    "caller_type": {
      "type": "string",
      "enum": [
        "owner",
        "media_specialist",
        "client",
        "b2b_client",
        "public",
        "unknown"
      ],
      "enumColors": [
        "purple",
        "blue",
        "green",
        "green",
        "gray",
        "gray"
      ],
      "default": "unknown"
    },
    "category": {
      "type": "string",
      "enum": [
        "technical_support",
        "booking",
        "media_specialist",
        "client",
        "general"
      ],
      "enumColors": [
        "red",
        "green",
        "blue",
        "green",
        "gray"
      ],
      "default": "general"
    },
    "related_signup_id": {
      "type": "string"
    },
    "related_contact_id": {
      "type": "string"
    },
    "related_organization_id": {
      "type": "string"
    },
    "related_job_id": {
      "type": "string"
    },
    "support_case_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "reviewed",
        "unresolved",
        "resolved"
      ],
      "enumColors": [
        "yellow",
        "blue",
        "red",
        "green"
      ],
      "default": "new"
    },
    "reviewed_by": {
      "type": "string"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "resolution_notes": {
      "type": "string"
    },
    "owner_notified_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "voicemail_id",
    "recording_sid",
    "from_number"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}