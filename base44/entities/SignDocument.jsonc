{
  "name": "SignDocument",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Tenant this document template belongs to",
      "default": "tnt_estate_media"
    },
    "document_id": {
      "type": "string",
      "description": "Stable document identifier (e.g. offer_letter_default). Unique within tenant."
    },
    "title": {
      "type": "string",
      "description": "Document display title shown to admins and candidates"
    },
    "document_type": {
      "type": "string",
      "enum": [
        "offer_letter",
        "employment_agreement",
        "nda",
        "addendum",
        "w9",
        "ica",
        "custom"
      ],
      "default": "custom",
      "description": "Category of document. Drives special handling (e.g. offer_letter updates JobApplication status on signature)."
    },
    "document_category": {
      "type": "string",
      "enum": [
        "agreement",
        "hr_document",
        "regular_document"
      ],
      "default": "regular_document",
      "description": "Category label: agreement (B2B contracts via Arriv Agreements), hr_document (HR/hiring docs), regular_document (general). Used to filter views in different admin pages."
    },
    "source_type": {
      "type": "string",
      "enum": [
        "upload",
        "editor"
      ],
      "description": "How the document was created. 'upload' = admin uploaded a finished PDF; 'editor' = admin wrote rich-text in the built-in editor with merge fields."
    },
    "body_ref": {
      "type": "string",
      "description": "For source_type=upload: the private file_uri of the uploaded PDF. For source_type=editor: empty."
    },
    "body_html": {
      "type": "string",
      "description": "For source_type=editor: the rich-text HTML body with merge field placeholders and signature field placeholders. For source_type=upload: empty."
    },
    "merge_fields": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "List of merge field keys available in this document's body."
    },
    "signature_fields": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "field_id": {
            "type": "string",
            "description": "Stable field identifier. For editor docs, derived from the placeholder label. For upload docs, auto-generated."
          },
          "type": {
            "type": "string",
            "enum": [
              "signature",
              "date",
              "name",
              "text",
              "initial"
            ],
            "default": "signature",
            "description": "Field type."
          },
          "label": {
            "type": "string",
            "description": "Display label shown to the signer next to the field"
          },
          "required": {
            "type": "boolean",
            "default": true,
            "description": "Whether the signer must fill this field before submitting"
          },
          "x": {
            "type": "number",
            "description": "Horizontal position as a percentage (0-100) of the PDF page width. Used for upload/PDF documents. Empty for editor documents."
          },
          "y": {
            "type": "number",
            "description": "Vertical position as a percentage (0-100) of the PDF page height. Used for upload/PDF documents."
          },
          "page": {
            "type": "integer",
            "default": 1,
            "description": "PDF page number this field is placed on (1-indexed)."
          },
          "width": {
            "type": "number",
            "default": 30,
            "description": "Field width as a percentage (0-100) of the PDF page width."
          },
          "height_pct": {
            "type": "number",
            "default": 3,
            "description": "Field height as a percentage (0-100) of the PDF page height. Set by the admin when placing fields."
          },
          "assigned_signer": {
            "type": "string",
            "description": "Email address of the signer assigned to this field. When set, only that signer sees and fills this field. Empty = assigned to the primary recipient."
          },
          "placeholder_text": {
            "type": "string",
            "description": "The original document text at this field's position that will be physically removed from the PDF content stream when the document is sent for signing."
          },
          "static_value": {
            "type": "string",
            "description": "For 'text' fields: admin-authored content burned into the document. When set, the field is NOT signer-fillable \u2014 it renders as read-only text. Empty = the signer fills in this field."
          }
        },
        "required": [
          "field_id",
          "type",
          "label"
        ]
      },
      "default": [],
      "description": "Signature field definitions. For editor docs, fields are placed inline via placeholders. For upload docs, fields are overlaid on the PDF at their x/y/page positions."
    },
    "version": {
      "type": "string",
      "default": "1.0",
      "description": "Document version label. Incrementing this triggers re-sign for new requests; existing signed requests retain their snapshot."
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this template is available for sending new sign requests"
    },
    "change_summary": {
      "type": "string",
      "description": "What changed in this version (optional)"
    },
    "created_by_name": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "tenant_id",
    "document_id",
    "title",
    "source_type"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}