{
  "name": "OrientationAuditLog",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "description": "Unique event ID"
    },
    "arriv_employee_id": {
      "type": "string",
      "description": "Employee the event concerns"
    },
    "actor": {
      "type": "string",
      "description": "User or system that performed the action"
    },
    "role": {
      "type": "string",
      "description": "Role of the actor (employee, manager, hr, owner, system)"
    },
    "action": {
      "type": "string",
      "description": "Action performed"
    },
    "orientation_section": {
      "type": "string",
      "description": "Section the action affected"
    },
    "affected_record": {
      "type": "string",
      "description": "ID of the affected record"
    },
    "previous_status": {
      "type": "string"
    },
    "new_status": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "request_id": {
      "type": "string"
    },
    "source_application": {
      "type": "string"
    },
    "result": {
      "type": "string",
      "enum": [
        "success",
        "failure",
        "warning"
      ],
      "default": "success"
    },
    "safe_failure_message": {
      "type": "string",
      "description": "Safe (non-sensitive) failure message"
    }
  },
  "required": [
    "event_id",
    "arriv_employee_id",
    "actor",
    "action",
    "timestamp"
  ]
}