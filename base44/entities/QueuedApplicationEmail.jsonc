{
  "name": "QueuedApplicationEmail",
  "type": "object",
  "properties": {
    "recipient_email": {
      "type": "string",
      "description": "Recipient email address"
    },
    "subject": {
      "type": "string",
      "description": "Email subject line"
    },
    "html_content": {
      "type": "string",
      "description": "Full HTML email body to send"
    },
    "scheduled_for": {
      "type": "string",
      "format": "date-time",
      "description": "When to send this email (next 8:00 AM Eastern Time)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "submitted",
        "sent",
        "failed"
      ],
      "default": "pending",
      "description": "Pending awaits submission; submitted has a Brevo receipt but no delivery confirmation; sent is confirmed delivered for receipt-tracked emails. Legacy sent records may have no receipt."
    },
    "attempts": {
      "type": "integer",
      "default": 0,
      "description": "Number of send attempts made"
    },
    "max_attempts": {
      "type": "integer",
      "default": 5,
      "description": "Maximum send attempts before giving up"
    },
    "last_error": {
      "type": "string",
      "description": "Last error message from a failed send attempt"
    },
    "provider_message_id": {
      "type": "string",
      "description": "Brevo message receipt. An existing receipt prevents automatic resending."
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time",
      "description": "When Brevo accepted the request, not proof of delivery"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "Confirmed delivery time for receipt-tracked emails; legacy rows used submission time"
    }
  },
  "required": [
    "recipient_email",
    "subject",
    "html_content",
    "scheduled_for"
  ]
}