{
  "name": "CallCenterSetting",
  "type": "object",
  "properties": {
    "settings_key": {
      "type": "string",
      "default": "default",
      "description": "Singleton key. One settings record drives the whole IVR."
    },
    "sales_rep_member_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "SalesTeamMember ids eligible for the sales ring group. Adding a Growth Advisor here needs no code change."
    },
    "stage1_timeout": {
      "type": "number",
      "default": 18,
      "description": "Seconds to ring primary business numbers"
    },
    "stage2_timeout": {
      "type": "number",
      "default": 18,
      "description": "Seconds to ring cellphone fallbacks"
    },
    "stage3_timeout": {
      "type": "number",
      "default": 20,
      "description": "Seconds to ring the owner fallback number"
    },
    "owner_fallback_number": {
      "type": "string",
      "default": "+14047891107"
    },
    "support_number": {
      "type": "string",
      "default": "+14047891107"
    },
    "support_timeout": {
      "type": "number",
      "default": 25
    },
    "public_caller_id": {
      "type": "string",
      "default": "+18557654306",
      "description": "Caller ID shown on the owner's phone for every IVR transfer"
    },
    "agent_acceptance_required": {
      "type": "boolean",
      "default": false,
      "description": "Ask the answering representative to press 1 before connecting, so a phone voicemail greeting cannot claim a sales call"
    },
    "ashley_enabled": {
      "type": "boolean",
      "default": true
    },
    "ashley_max_turns": {
      "type": "number",
      "default": 12
    },
    "ashley_booking_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Allow Ashley to submit a booking through the standard booking workflow"
    },
    "callback_assignment": {
      "type": "string",
      "enum": [
        "owner",
        "client_owner",
        "round_robin"
      ],
      "enumColors": [
        "purple",
        "blue",
        "green"
      ],
      "default": "owner"
    },
    "greeting_specialist": {
      "type": "string",
      "default": "Hi {first_name}, thank you for being the best part of Arriv. How can we help you today?"
    },
    "greeting_client": {
      "type": "string",
      "default": "Hi {first_name}, thank you for being the best part of Arriv. How can we help you today?"
    },
    "greeting_prospect": {
      "type": "string",
      "default": "Hi {first_name}, thank you for calling Arriv Estate Media. Please hold for {rep_name}.",
      "description": "Spoken to a recognised sales prospect from Arriv One. {first_name} is the prospect's first name, {rep_name} is the Growth Advisor on file. When no advisor has a number, {rep_name} becomes \"our team\" and the sales ring group is used."
    },
    "greeting_public": {
      "type": "string",
      "default": "Thank you for calling Arriv Estate Media. To book media for your property, press 1. For assistance signing up or booking through our portal, press 2."
    },
    "support_overflow_text": {
      "type": "string",
      "default": "Thank you for calling Arriv. Unfortunately, we're experiencing a high call volume. Please press 1 to request a callback or press 2 to leave a voicemail."
    },
    "tech_support_prompt": {
      "type": "string",
      "default": "Sorry for the issues you're experiencing. Please leave a detailed message explaining what you're trying to accomplish, and we'll get back with you as soon as possible."
    },
    "sales_unavailable_text": {
      "type": "string",
      "default": "One moment while we connect you."
    },
    "voicemail_enabled": {
      "type": "boolean",
      "default": true
    },
    "voicemail_max_seconds": {
      "type": "number",
      "default": 180
    },
    "notify_owner_on_voicemail": {
      "type": "boolean",
      "default": true
    },
    "notify_owner_on_callback": {
      "type": "boolean",
      "default": true
    },
    "notify_owner_on_ticket": {
      "type": "boolean",
      "default": true
    },
    "notify_number": {
      "type": "string",
      "description": "Number that receives call-center SMS alerts. Falls back to the owner number when empty."
    },
    "updated_by": {
      "type": "string"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "settings_key"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}