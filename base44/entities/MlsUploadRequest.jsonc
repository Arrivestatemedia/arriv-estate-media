{
  "name": "MlsUploadRequest",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "default": "tnt_estate_media",
      "description": "Multi-tenant isolation key"
    },
    "request_id": {
      "type": "string",
      "description": "Stable request ID (mls_req_...)"
    },
    "job_id": {
      "type": "string",
      "description": "Job the requested media belongs to"
    },
    "booking_id": {
      "type": "string",
      "description": "Booking behind the job, when one exists"
    },
    "provider": {
      "type": "string",
      "enum": [
        "fmls",
        "georgia_mls",
        "bright_mls",
        "unresolved"
      ],
      "default": "fmls",
      "description": "MLS provider resolved from the property's service area. 'unresolved' means the address was ambiguous or overlapping and an administrator must decide."
    },
    "region_id": {
      "type": "string",
      "description": "Service-area region that decided the provider (see mls_service_regions)"
    },
    "region_label": {
      "type": "string",
      "description": "Human-readable service area the property falls in"
    },
    "region_basis": {
      "type": "string",
      "enum": [
        "zip",
        "county",
        "city",
        "state",
        "none"
      ],
      "description": "Most specific address attribute that matched the service area"
    },
    "region_resolution": {
      "type": "object",
      "description": "Full record of how the provider was chosen: status, reason, matched regions and the parsed property location. Kept so a routing decision can always be explained after the fact.",
      "properties": {
        "status": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "basis": {
          "type": "string"
        },
        "provider_id": {
          "type": "string"
        },
        "provider_live": {
          "type": "boolean"
        },
        "region_id": {
          "type": "string"
        },
        "region_label": {
          "type": "string"
        },
        "matches": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "location": {
          "type": "object"
        }
      }
    },
    "mls_number_required": {
      "type": "boolean",
      "default": true,
      "description": "Whether the customer had to supply a listing number for this provider. False for address-matched providers such as Bright."
    },
    "mls_number": {
      "type": "string",
      "description": "Existing MLS listing number supplied by the customer"
    },
    "mls_number_normalized": {
      "type": "string",
      "description": "Normalized listing number used for duplicate checks and display"
    },
    "client_email": {
      "type": "string",
      "description": "Customer who submitted the request. Matched against the job's client_email server-side."
    },
    "client_name": {
      "type": "string"
    },
    "client_phone": {
      "type": "string"
    },
    "property_address": {
      "type": "string",
      "description": "Street address of the property, taken from the job and booking"
    },
    "selected_media": {
      "type": "array",
      "description": "Customer-selected media in the customer's chosen display order",
      "items": {
        "type": "object",
        "properties": {
          "drive_file_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "photo",
              "video"
            ]
          },
          "position": {
            "type": "integer"
          },
          "youtube_url": {
            "type": "string"
          }
        }
      }
    },
    "selected_photo_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Google Drive file IDs of the selected photographs, in display order"
    },
    "selected_video_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Google Drive file IDs of the selected videos"
    },
    "selected_photo_order": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Explicit photo display order (Drive file IDs) preserved for the upload package"
    },
    "selected_youtube_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Unbranded YouTube links ready at submission time, offered as the virtual tour URL"
    },
    "photo_count": {
      "type": "integer",
      "default": 0
    },
    "video_count": {
      "type": "integer",
      "default": 0
    },
    "unsupported_media": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Selected items that cannot be sent to the provider, recorded for the administrator"
    },
    "authorization_confirmed": {
      "type": "boolean",
      "default": false,
      "description": "Customer confirmed they are authorized to request media uploads to this listing"
    },
    "authorization_snapshot": {
      "type": "string",
      "description": "Exact authorization wording presented at submission, preserved as evidence"
    },
    "authorized_at": {
      "type": "string",
      "format": "date-time"
    },
    "authorized_by_email": {
      "type": "string",
      "description": "Verified customer identity that authorized the upload"
    },
    "status": {
      "type": "string",
      "enum": [
        "submitted",
        "processing",
        "photos_uploaded",
        "video_added",
        "completed",
        "needs_attention",
        "cancelled"
      ],
      "default": "submitted",
      "description": "Administrative upload lifecycle. Independent of the job's delivery status."
    },
    "photo_upload_status": {
      "type": "string",
      "enum": [
        "pending",
        "uploaded",
        "not_required"
      ],
      "default": "pending"
    },
    "video_upload_status": {
      "type": "string",
      "enum": [
        "pending",
        "added",
        "not_required"
      ],
      "default": "pending"
    },
    "manifest_status": {
      "type": "string",
      "enum": [
        "not_applicable",
        "generated",
        "blocked_pending_certification",
        "transmitted"
      ],
      "default": "not_applicable",
      "description": "Bright Media Sync manifest state. 'generated' means the manifest is ready but not sent; 'transmitted' only after Bright accepted it."
    },
    "provider_manifest": {
      "type": "object",
      "description": "Provider-specific payload built at submission (the Bright Media Sync manifest). Recorded, never transmitted while the integration is uncertified."
    },
    "manifest_checksum": {
      "type": "string",
      "description": "SHA-256 of the manifest body, so a stored manifest can be proven unchanged"
    },
    "bright_manifest_id": {
      "type": "string",
      "description": "The manifestId Bright returned when it accepted this request's manifest. Its presence is the only proof the manifest reached Bright, and it prevents a second submission of the same request."
    },
    "bright_import_url": {
      "type": "string",
      "description": "Bright's documented import link for that manifestId (/mlsredirect/bright/{manifestId}). Opening it is how the agent pulls the media into the listing; it is not proof the import finished."
    },
    "bright_submitted_at": {
      "type": "string",
      "format": "date-time",
      "description": "When Bright accepted the manifest"
    },
    "bright_submission_attempts": {
      "type": "integer",
      "default": 0,
      "description": "How many times this request's manifest has been POSTed to Bright"
    },
    "bright_last_status": {
      "type": "integer",
      "description": "HTTP status of the most recent attempt (0 when Bright could not be reached)"
    },
    "bright_last_error": {
      "type": "string",
      "description": "Plain-language reason the most recent attempt did not produce a manifestId"
    },
    "bright_last_attempt_at": {
      "type": "string",
      "format": "date-time"
    },
    "bright_next_retry_at": {
      "type": "string",
      "format": "date-time",
      "description": "When a safe retry (429 only, where Bright certainly created nothing) may be attempted. Empty once accepted, after a rejection that needs a fix, or when the outcome is ambiguous."
    },
    "bright_response": {
      "type": "object",
      "description": "Bright's last reply, recorded verbatim for review: outcome, HTTP status, message and the response body."
    },
    "bright_needs_verification": {
      "type": "boolean",
      "default": false,
      "description": "A previous attempt may have created a billable manifest before it failed (timeout, dropped connection, 5xx or a 2xx with no manifestId). While true nothing is retried automatically and no resend is allowed until a person confirms in Bright that the manifest is absent."
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "processing_started_at": {
      "type": "string",
      "format": "date-time"
    },
    "deadline_at": {
      "type": "string",
      "format": "date-time",
      "description": "Two-business-hour service deadline, calculated in America/New_York operating hours"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_by": {
      "type": "string",
      "description": "Administrator who confirmed the upload"
    },
    "admin_notified_at": {
      "type": "string",
      "format": "date-time"
    },
    "client_notified_at": {
      "type": "string",
      "format": "date-time"
    },
    "reminder_60_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "60 business minutes elapsed reminder"
    },
    "reminder_90_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "90 business minutes elapsed reminder"
    },
    "overdue_notified_at": {
      "type": "string",
      "format": "date-time"
    },
    "attention_reason": {
      "type": "string",
      "description": "Why the request needs attention (ambiguous coverage, uncertified route, invalid MLS number, inaccessible listing, unsupported media)"
    },
    "admin_notes": {
      "type": "string"
    },
    "status_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "actor": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      },
      "description": "Append-only record of every status change"
    },
    "duplicate_key": {
      "type": "string",
      "description": "job_id + provider + normalized MLS number. An open request with the same key blocks a duplicate submission."
    }
  },
  "required": [
    "request_id",
    "job_id",
    "provider",
    "client_email",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}