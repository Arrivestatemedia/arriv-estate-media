{
  "name": "SmsTrackedLink",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "Short opaque tracking code used in the redirect URL. Never reveals the destination or the customer."
    },
    "target_url": {
      "type": "string",
      "description": "The original destination URL, preserved exactly. The redirect always sends the visitor here."
    },
    "dest_label": {
      "type": "string",
      "description": "Human-readable description of the destination shown to the representative (for example 'Arriv page (book)')"
    },
    "message_id": {
      "type": "string",
      "description": "SmsMessage row this link was sent in"
    },
    "message_sid": {
      "type": "string",
      "description": "Twilio SID of the message this link was sent in"
    },
    "conversation_id": {
      "type": "string",
      "description": "SmsConversation this link belongs to"
    },
    "sales_member_id": {
      "type": "string",
      "description": "Assigned sales representative, so engagement is attributed to the right rep"
    },
    "customer_number": {
      "type": "string",
      "description": "Recipient phone number the link was sent to"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "first_click_at": {
      "type": "string",
      "format": "date-time",
      "description": "First observed access of the link"
    },
    "last_click_at": {
      "type": "string",
      "format": "date-time",
      "description": "Most recent observed access of the link"
    },
    "click_count": {
      "type": "integer",
      "default": 0,
      "description": "Total accesses observed, including automated ones"
    },
    "human_click_count": {
      "type": "integer",
      "default": 0,
      "description": "Accesses that look like a real device. Never treated as proof that a message was read."
    },
    "preview_count": {
      "type": "integer",
      "default": 0,
      "description": "Accesses that look like a link preview or automated scanner"
    },
    "last_event_type": {
      "type": "string",
      "enum": [
        "",
        "human",
        "preview",
        "unknown"
      ],
      "default": "",
      "description": "Classification of the most recent access. No IP address or raw user-agent is ever stored."
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Retention marker for the tracking row. The redirect itself does not expire."
    }
  },
  "required": [
    "code",
    "target_url"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}