{
  "name": "SignRequest",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Tenant this sign request belongs to",
      "default": "tnt_estate_media"
    },
    "request_id": {
      "type": "string",
      "description": "Stable request identifier (e.g. sigreq_xxx)"
    },
    "document_id": {
      "type": "string",
      "description": "SignDocument.document_id this request was created from"
    },
    "document_title": {
      "type": "string",
      "description": "Snapshot of the document title at send time"
    },
    "document_type": {
      "type": "string",
      "enum": [
        "offer_letter",
        "employment_agreement",
        "nda",
        "addendum",
        "w9",
        "ica",
        "custom"
      ],
      "description": "Snapshot of the document type at send time"
    },
    "document_version": {
      "type": "string",
      "description": "Snapshot of the document version at send time"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "upload",
        "editor"
      ],
      "description": "Snapshot of the document source type"
    },
    "merged_body_html": {
      "type": "string",
      "description": "For source_type=editor: the rendered HTML with merge fields filled in. Frozen at send time."
    },
    "body_ref": {
      "type": "string",
      "description": "For source_type=upload: the private file_uri of the original PDF. Frozen at send time."
    },
    "cleaned_body_ref": {
      "type": "string",
      "description": "Private file_uri of the PDF with placeholder text physically removed from the content stream. Used for both the signing preview and the final signed PDF generation. Empty when no cleaning was needed or for editor docs."
    },
    "signature_fields": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "field_id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "signature",
              "date",
              "name",
              "text",
              "initial"
            ]
          },
          "label": {
            "type": "string"
          },
          "required": {
            "type": "boolean",
            "default": true
          },
          "x": {
            "type": "number",
            "description": "Horizontal position as a percentage (0-100) of the PDF page width. Frozen from SignDocument at send time."
          },
          "y": {
            "type": "number",
            "description": "Vertical position as a percentage (0-100) of the PDF page height."
          },
          "page": {
            "type": "integer",
            "default": 1
          },
          "width": {
            "type": "number",
            "default": 30
          },
          "height_pct": {
            "type": "number",
            "default": 3,
            "description": "Field height as a percentage (0-100) of the PDF page height. Frozen from SignDocument at send time."
          },
          "assigned_signer": {
            "type": "string",
            "description": "Email of the signer assigned to this field. Frozen from SignDocument at send time."
          },
          "placeholder_text": {
            "type": "string",
            "description": "The original document text at this field's position that was physically removed from the PDF content stream. Frozen from SignDocument at send time."
          },
          "static_value": {
            "type": "string",
            "description": "For 'text' fields: admin-authored content burned into the document. Frozen from SignDocument at send time. When set, the field is read-only (not signer-fillable) and rendered on the final signed PDF."
          }
        }
      },
      "default": [],
      "description": "Snapshot of signature field definitions from the SignDocument at send time. Frozen so the signed record matches what the candidate saw."
    },
    "signature_field_values": {
      "type": "object",
      "description": "Map of field_id to the value the signer entered for that field. Populated on signature submission. For drawn signatures, the value is a file_uri (not a data URL).",
      "default": {}
    },
    "application_id": {
      "type": "string",
      "description": "JobApplication ID this request was sent to. Empty for standalone recipients (free-form email)."
    },
    "sign_group_id": {
      "type": "string",
      "description": "Links multiple SignRequests that are part of the same multi-signer document."
    },
    "signing_order": {
      "type": "integer",
      "description": "1-based position of this signer in the signing succession. Signer 1 can sign immediately; signer N (N>1) cannot sign until all signers 1..N-1 in the same sign_group_id have signed. 0 or 1 = no ordering constraint."
    },
    "sign_group_total": {
      "type": "integer",
      "description": "Total number of signers in this sign_group_id."
    },
    "signer_email": {
      "type": "string",
      "description": "The specific signer this request was sent to (for multi-signer documents). Falls back to candidate_email for single-signer documents."
    },
    "signer_name": {
      "type": "string",
      "description": "The specific signer's display name. Falls back to candidate_name for single-signer documents."
    },
    "candidate_name": {
      "type": "string",
      "description": "Denormalized candidate full name"
    },
    "candidate_email": {
      "type": "string",
      "description": "Denormalized candidate email"
    },
    "sign_token": {
      "type": "string",
      "description": "Opaque token used to access the standalone signing page (/sign/:token) without login. Cryptographically random."
    },
    "status": {
      "type": "string",
      "enum": [
        "sent",
        "viewed",
        "signed",
        "declined",
        "voided",
        "expired"
      ],
      "default": "sent",
      "description": "Current lifecycle status of this sign request"
    },
    "signing_location": {
      "type": "string",
      "enum": [
        "portal",
        "link"
      ],
      "default": "link",
      "description": "Where the candidate signs."
    },
    "signature_value": {
      "type": "string",
      "description": "The typed name the candidate entered, or '[Drawn Signature]' if they drew it."
    },
    "signature_method": {
      "type": "string",
      "enum": [
        "typed",
        "drawn",
        "clickwrap"
      ],
      "default": "typed",
      "description": "How the candidate signed."
    },
    "ip_address": {
      "type": "string",
      "description": "IP address of the signer at the moment of signature (audit trail)"
    },
    "user_agent": {
      "type": "string",
      "description": "User-Agent header of the signer at the moment of signature (audit trail)"
    },
    "signed_pdf_uri": {
      "type": "string",
      "description": "Private file_uri of the final signed PDF generated after signature."
    },
    "orientation_document_id": {
      "type": "string",
      "description": "ID of the OrientationDocument audit-trail record created when this request was signed."
    },
    "sent_by_name": {
      "type": "string",
      "description": "Name of the admin who sent the request"
    },
    "sent_by_email": {
      "type": "string",
      "description": "Email of the admin who sent the request. Used to notify the admin when the document is signed."
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "viewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "signed_at": {
      "type": "string",
      "format": "date-time"
    },
    "declined_at": {
      "type": "string",
      "format": "date-time"
    },
    "voided_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the request expires (optional)."
    },
    "organization_id": {
      "type": "string",
      "description": "B2B organization ID this request belongs to (B2B/commercial context). Empty for HR requests."
    },
    "agreement_type": {
      "type": "string",
      "description": "B2B agreement type (B2B_SERVICE_AGREEMENT, ORDER_FORM, etc.). Empty for HR requests."
    },
    "sales_rep_email": {
      "type": "string",
      "description": "Email of the sales rep who sent this request (B2B context)"
    },
    "completion_certificate_uri": {
      "type": "string",
      "description": "Private file_uri of the generated completion certificate (after all signers complete)"
    }
  },
  "required": [
    "tenant_id",
    "request_id",
    "document_id",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}