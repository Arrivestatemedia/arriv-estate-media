{
  "name": "Account",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Canonical tenant ID for multi-tenant isolation",
      "default": "tnt_estate_media"
    },
    "sales_member_id": {
      "type": "string",
      "description": "ID of the sales team member who owns this account (local SalesTeamMember ID, used for per-rep RLS isolation)"
    },
    "name": {
      "type": "string",
      "description": "Account / company name (brokerage, real estate team, builder, developer, agency)"
    },
    "type": {
      "type": "string",
      "enum": [
        "brokerage",
        "real_estate_team",
        "builder",
        "developer",
        "agency",
        "other"
      ],
      "description": "Account type \u2014 maps to Estate Media prospect types"
    },
    "email": {
      "type": "string",
      "description": "Primary email address"
    },
    "phone": {
      "type": "string",
      "description": "Primary phone number"
    },
    "website": {
      "type": "string",
      "description": "Company website URL"
    },
    "address": {
      "type": "string",
      "description": "Street address"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "zip": {
      "type": "string"
    },
    "industry": {
      "type": "string",
      "description": "Industry vertical (real_estate, construction, property_management, etc.)"
    },
    "description": {
      "type": "string",
      "description": "Account description / notes"
    },
    "owner_id": {
      "type": "string",
      "description": "ID of the sales rep who owns this account"
    },
    "lifecycle_stage": {
      "type": "string",
      "enum": [
        "lead",
        "mql",
        "sql",
        "opportunity",
        "customer",
        "churned"
      ],
      "description": "CRM lifecycle stage (synced from Arriv One \u2014 Arriv One owns CRM lifecycle)"
    },
    "hubspot_id": {
      "type": "string",
      "description": "Original HubSpot company/account ID (for migration mapping)"
    },
    "record_version": {
      "type": "integer",
      "default": 1,
      "description": "Monotonic record version for sync conflict detection"
    },
    "sync_source": {
      "type": "string",
      "enum": [
        "estate_media",
        "arriv_one"
      ],
      "description": "Which application last wrote this record via sync"
    },
    "origin_event_id": {
      "type": "string",
      "description": "Inbound event ID that caused the last sync write (loop prevention)"
    },
    "immutable_shared_id": {
      "type": "string",
      "description": "Immutable cross-app shared identifier"
    },
    "account_engagement_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Canonical Arriv One Customer360 account-level engagement score (0-100). Arriv One-authoritative \u2014 Estate Media reads but never writes."
    },
    "account_lifetime_value": {
      "type": "number",
      "description": "Canonical account-level lifetime value from Arriv One Customer360 purchase intelligence. Arriv One-authoritative."
    },
    "account_buying_patterns": {
      "type": "string",
      "description": "Canonical account-level buying pattern analysis from Arriv One Customer360. Arriv One-authoritative."
    },
    "account_relationship_health": {
      "type": "string",
      "enum": [
        "healthy",
        "at_risk",
        "critical",
        "churned"
      ],
      "description": "Canonical account-level relationship health from Arriv One Customer360. Arriv One-authoritative."
    },
    "account_churn_risk": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Canonical account-level churn risk (0-100) from Arriv One Customer360. Arriv One-authoritative."
    },
    "account_next_best_action": {
      "type": "string",
      "description": "Canonical account-level recommended next best action from Arriv One Customer360 sales intelligence. Arriv One-authoritative."
    },
    "account_upsell_opportunities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Canonical account-level upsell opportunities from Arriv One Customer360. Arriv One-authoritative."
    },
    "account_sales_memory": {
      "type": "object",
      "properties": {
        "successful_approaches": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "objections": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "relationship_notes": {
          "type": "string"
        }
      },
      "description": "Canonical account-level AI sales memory from Arriv One Customer360. Arriv One-authoritative."
    },
    "account_intelligence_synced_at": {
      "type": "string",
      "format": "date-time",
      "description": "When Arriv One last refreshed account-level Customer360 intelligence. Arriv One-authoritative."
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    },
    "create": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    },
    "update": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    },
    "delete": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    }
  }
}