{
  "name": "OfferLetter",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Tenant ID for multi-tenant isolation",
      "default": "tnt_estate_media"
    },
    "name": {
      "type": "string",
      "description": "Offer letter template name"
    },
    "body_content": {
      "type": "string",
      "description": "Template body with variable placeholders: {{candidate_first_name}}, {{job_title}}, {{company_name}}, {{signature_name}}, {{signature_title}}"
    },
    "is_active": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is the active offer letter template (only one can be active at a time)"
    }
  },
  "required": [
    "name",
    "body_content"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}