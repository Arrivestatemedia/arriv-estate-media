{
  "name": "Invoice",
  "type": "object",
  "properties": {
    "invoice_number": {
      "type": "string",
      "description": "Sequential invoice number"
    },
    "invoice_type": {
      "type": "string",
      "enum": [
        "pay_up_front",
        "deposit",
        "final_closing",
        "receipt",
        "b2b_annual_contract",
        "b2b_implementation",
        "b2b_approved_overage"
      ],
      "description": "Type of invoice/document. B2B types are for B2B commercial invoices."
    },
    "invoice_source": {
      "type": "string",
      "enum": [
        "retail_booking",
        "b2b_annual_contract",
        "b2b_implementation",
        "b2b_approved_overage"
      ],
      "description": "Source context: distinguishes retail booking invoices from B2B commercial invoices."
    },
    "b2b_organization_id": {
      "type": "string",
      "description": "B2B Organization ID (for B2B invoice types only)"
    },
    "b2b_contract_id": {
      "type": "string",
      "description": "B2B Contract ID (for B2B invoice types only)"
    },
    "b2b_contract_version_id": {
      "type": "string",
      "description": "B2B Contract Version ID (for B2B invoice types only)"
    },
    "job_id": {
      "type": "string",
      "description": "Related job ID"
    },
    "booking_id": {
      "type": "string",
      "description": "Related booking ID"
    },
    "client_name": {
      "type": "string",
      "description": "Client name"
    },
    "client_email": {
      "type": "string",
      "description": "Client email"
    },
    "job_address": {
      "type": "string",
      "description": "Property address"
    },
    "service_date": {
      "type": "string",
      "format": "date",
      "description": "Date of service"
    },
    "package": {
      "type": "string",
      "description": "Package selected"
    },
    "add_ons": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Add-ons selected"
    },
    "amount": {
      "type": "number",
      "description": "Invoice amount"
    },
    "deposit_amount": {
      "type": "number",
      "description": "Deposit amount if applicable"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "unpaid",
        "paid"
      ],
      "default": "unpaid",
      "description": "Payment status"
    },
    "stripe_payment_link_id": {
      "type": "string",
      "description": "Stripe payment link ID"
    },
    "stripe_payment_link_url": {
      "type": "string",
      "description": "Stripe payment link URL"
    },
    "stripe_payment_intent_id": {
      "type": "string",
      "description": "Stripe PaymentIntent ID when paid"
    },
    "stripe_checkout_session_id": {
      "type": "string",
      "description": "Stripe Checkout Session ID for matching webhook events"
    },
    "google_drive_unpaid_url": {
      "type": "string",
      "description": "Google Drive link in UNPAID folder"
    },
    "google_drive_paid_url": {
      "type": "string",
      "description": "Google Drive link in PAID folder after payment"
    },
    "google_drive_file_id": {
      "type": "string",
      "description": "Google Drive file ID for management"
    },
    "tracked_link_token": {
      "type": "string",
      "description": "Token for Base44 tracked link"
    },
    "tracked_link_url": {
      "type": "string",
      "description": "Base44 tracked redirect URL"
    },
    "email_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "When initial invoice email was sent"
    },
    "link_clicked_at": {
      "type": "string",
      "format": "date-time",
      "description": "When invoice link was first clicked"
    },
    "paid_at": {
      "type": "string",
      "format": "date-time",
      "description": "When payment was received"
    },
    "reminder_1_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "24h reminder sent timestamp"
    },
    "reminder_2_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "48h reminder sent timestamp"
    },
    "pay_at_closing": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is a pay-at-closing job"
    },
    "closing_date": {
      "type": "string",
      "format": "date",
      "description": "Date property closed (for final invoices)"
    },
    "final_sale_price": {
      "type": "number",
      "description": "Final sale price for pay-at-closing calculation"
    },
    "pay_at_closing_rate": {
      "type": "number",
      "description": "Pay-at-closing percentage rate"
    },
    "package_minimum": {
      "type": "number",
      "description": "Package minimum for pay-at-closing"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "Due date for B2B invoices"
    },
    "invoice_date": {
      "type": "string",
      "format": "date",
      "description": "Invoice creation date for B2B invoices"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes for B2B invoices"
    },
    "delinquency_status": {
      "type": "string",
      "enum": [
        "not_yet_due",
        "payment_pending",
        "payment_succeeded",
        "payment_declined",
        "payment_overdue",
        "retry_scheduled",
        "recovered",
        "grace_expired",
        "booking_restricted",
        "exception_approved",
        "subscription_cancelled"
      ],
      "description": "B2B delinquency lifecycle status. Calculated from due_date + payment_status + customer classification."
    },
    "grace_period_days": {
      "type": "integer",
      "description": "Calculated grace period in days based on customer classification (7/14/21/30). Null if classification ambiguous."
    },
    "grace_period_deadline": {
      "type": "string",
      "format": "date",
      "description": "Due date + grace period days. The date after which restrictions may apply."
    },
    "days_past_due": {
      "type": "integer",
      "description": "Days past the contractual due date (calculated)."
    },
    "delinquency_reminder_3d_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the 3-day post-due-date reminder was sent"
    },
    "delinquency_reminder_7d_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the 7-day post-due-date reminder was sent"
    },
    "restriction_warning_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the advance restriction warning was sent (for longer grace periods)"
    },
    "booking_restricted_at": {
      "type": "string",
      "format": "date-time",
      "description": "When new booking creation was restricted for this organization due to delinquency"
    },
    "restriction_notice_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the booking restriction notification was sent"
    },
    "recovered_at": {
      "type": "string",
      "format": "date-time",
      "description": "When payment was recovered after a delinquency period"
    },
    "recovery_notice_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the payment recovery notification was sent"
    },
    "management_exception_status": {
      "type": "string",
      "enum": [
        "none",
        "pending",
        "approved",
        "expired",
        "denied"
      ],
      "default": "none",
      "description": "Management exception status for enterprise accounts or documented payment arrangements"
    },
    "management_exception_approved_by": {
      "type": "string",
      "description": "Admin email who approved the management exception"
    },
    "management_exception_reason": {
      "type": "string",
      "description": "Reason for the management exception or payment arrangement"
    },
    "management_exception_expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the management exception expires"
    },
    "payment_retry_scheduled_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the next payment retry is scheduled"
    },
    "partial_payment_amount": {
      "type": "number",
      "description": "Amount of partial payment received (if applicable). Invoice remains unpaid until full amount is collected."
    },
    "certification_mode": {
      "type": "boolean",
      "default": false,
      "description": "True if this is a synthetic certification test invoice (cert_-prefixed). Excluded from production analytics."
    }
  },
  "required": [
    "invoice_type",
    "client_name",
    "client_email",
    "job_address",
    "amount"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}