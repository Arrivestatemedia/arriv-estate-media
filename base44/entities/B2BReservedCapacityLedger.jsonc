{
  "name": "B2BReservedCapacityLedger",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "contract_id": {
      "type": "string"
    },
    "contract_version_id": {
      "type": "string",
      "description": "B2BContractVersion ID governing this event"
    },
    "period_id": {
      "type": "string",
      "description": "B2BReservedCapacityPeriod ID"
    },
    "booking_id": {
      "type": "string"
    },
    "booking_reference": {
      "type": "string",
      "description": "External booking reference (if applicable)"
    },
    "reservation_id": {
      "type": "string",
      "description": "Reservation ID linking RESERVATION, RESERVATION_RELEASE, and BOOKING_CONSUMPTION events"
    },
    "original_event_id": {
      "type": "string",
      "description": "ID of the original ledger event this entry reverses or compensates (for reversals)"
    },
    "amount": {
      "type": "integer",
      "description": "Shoot count (positive for allocation/reversal, negative for consumption)"
    },
    "balance_before": {
      "type": "integer",
      "description": "Available shoot balance before this event"
    },
    "balance_after": {
      "type": "integer",
      "description": "Available shoot balance after this event"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "PERIOD_ALLOCATION",
        "RESERVATION",
        "RESERVATION_RELEASE",
        "BOOKING_CONSUMPTION",
        "BOOKING_REVERSAL",
        "OVERAGE",
        "EXPIRATION",
        "ADMIN_ADJUSTMENT",
        "CONTRACT_CHANGE",
        "MIGRATION"
      ],
      "description": "Capacity ledger event type"
    },
    "reason": {
      "type": "string"
    },
    "actor": {
      "type": "string"
    },
    "acting_user_id": {
      "type": "string",
      "description": "B2BOrganizationMember user_id of the acting member"
    },
    "organization_member_id": {
      "type": "string",
      "description": "B2BOrganizationMember ID of the acting member"
    },
    "config_version": {
      "type": "string"
    },
    "idempotency_key": {
      "type": "string",
      "description": "Idempotency key to prevent double consumption"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "organization_id",
    "contract_id",
    "amount",
    "event_type",
    "idempotency_key"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}