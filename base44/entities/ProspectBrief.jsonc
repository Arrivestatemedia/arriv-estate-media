{
  "name": "ProspectBrief",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Canonical tenant ID for multi-tenant isolation",
      "default": "tnt_estate_media"
    },
    "sales_member_id": {
      "type": "string",
      "description": "SalesTeamMember ID of the rep who owns this prospect brief"
    },
    "contact_id": {
      "type": "string",
      "description": "Contact ID this prospect brief is associated with (if claimed in CRM)"
    },
    "prospect_name": {
      "type": "string",
      "description": "Prospect name (agent, team lead, broker, etc.)"
    },
    "prospect_role": {
      "type": "string",
      "description": "Prospect role (e.g. Real Estate Agent, Broker, Builder)"
    },
    "prospect_brokerage": {
      "type": "string",
      "description": "Brokerage / company / team name"
    },
    "prospect_market": {
      "type": "string",
      "description": "Market area / location"
    },
    "prospect_phone": {
      "type": "string",
      "description": "Contact phone where legitimately available"
    },
    "prospect_email": {
      "type": "string",
      "description": "Contact email where legitimately available"
    },
    "prospect_website": {
      "type": "string",
      "description": "Prospect website URL"
    },
    "listing_address": {
      "type": "string",
      "description": "Specific listing address that triggered this prospect research"
    },
    "why_them": {
      "type": "string",
      "description": "Why THIS particular prospect is worth contacting"
    },
    "why_this_business": {
      "type": "string",
      "description": "Why the brokerage/team/builder may represent an Estate Media opportunity"
    },
    "listing_intelligence": {
      "type": "string",
      "description": "Active/recent listings, property/location context, approximate listing activity/volume, price range, relevant listing characteristics. UNKNOWN where evidence is insufficient."
    },
    "listing_price_range": {
      "type": "string",
      "description": "Approximate listing price range where supported (UNKNOWN if unavailable)"
    },
    "listing_activity_volume": {
      "type": "string",
      "description": "Approximate listing activity/volume where supported (UNKNOWN if unavailable)"
    },
    "media_audit": {
      "type": "string",
      "description": "Evaluation of available listing/media evidence"
    },
    "professional_video_status": {
      "type": "string",
      "enum": [
        "UNKNOWN",
        "NO_PROFESSIONAL_VIDEO",
        "PROFESSIONAL_VIDEO_PRESENT",
        "COMING_SOON_NO_MEDIA",
        "MEDIA_NOT_YET_VERIFIABLE"
      ],
      "description": "Professional video check result"
    },
    "professional_video_notes": {
      "type": "string",
      "description": "Evidence supporting the professional video status conclusion"
    },
    "potential_opportunity": {
      "type": "string",
      "description": "Currently sellable Estate Media opportunities based on evidence"
    },
    "suggested_opening": {
      "type": "string",
      "description": "Prospect-specific opening using actual research"
    },
    "questions_to_ask": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Prospect-specific discovery questions"
    },
    "likely_objections": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Likely objections based on Estate Media training truth"
    },
    "rep_notes": {
      "type": "string",
      "description": "Rep's own observations (added after generation)"
    },
    "staging_interest_signal": {
      "type": "boolean",
      "default": false,
      "description": "Whether a future staging-interest signal was detected"
    },
    "staging_boundary_note": {
      "type": "string",
      "description": "Boundary note: physical staging is NOT currently sellable"
    },
    "research_confidence": {
      "type": "string",
      "enum": [
        "HIGH",
        "MODERATE",
        "LOW",
        "UNKNOWN"
      ],
      "description": "Overall confidence in the research findings"
    },
    "research_sources": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Sources consulted during research (for rep verification)"
    },
    "role_context": {
      "type": "string",
      "description": "The prospect's role context and how it shapes the approach"
    },
    "account_context": {
      "type": "string",
      "description": "CRM account context: lifecycle stage, existing relationship, previous interactions, Customer360 intelligence"
    },
    "product_fit": {
      "type": "string",
      "description": "Which currently sellable Estate Media products best fit this prospect's role and situation, and why"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "sales_member_id",
    "prospect_name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.sales_member_id": "{{user.data.sales_member_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.sales_member_id": "{{user.data.sales_member_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.sales_member_id": "{{user.data.sales_member_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}