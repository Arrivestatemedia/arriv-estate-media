{
  "name": "PayoutHistory",
  "type": "object",
  "properties": {
    "media_partner_email": {
      "type": "string",
      "description": "Email of the media partner"
    },
    "media_partner_name": {
      "type": "string",
      "description": "Name of the media partner"
    },
    "amount": {
      "type": "number",
      "description": "Amount paid out"
    },
    "payout_method": {
      "type": "string",
      "enum": [
        "zelle",
        "bank_account",
        "stripe_connect"
      ],
      "description": "Method used for payout"
    },
    "payout_destination": {
      "type": "string",
      "description": "Zelle info, bank account last 4, or Stripe Connect account ID"
    },
    "payout_date": {
      "type": "string",
      "format": "date",
      "description": "Date of payout"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "completed"
      ],
      "default": "pending",
      "description": "Status of payout"
    },
    "payout_type": {
      "type": "string",
      "enum": [
        "payout",
        "apparel_deduction"
      ],
      "default": "payout",
      "description": "Type of payout entry (regular payout or apparel purchase deduction)"
    },
    "stripe_transfer_id": {
      "type": "string",
      "description": "Stripe Transfer ID (Stripe Connect payouts)"
    }
  },
  "required": [
    "media_partner_email",
    "amount",
    "payout_method",
    "payout_date"
  ]
}