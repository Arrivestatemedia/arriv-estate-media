{
  "name": "ChatChannel",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Channel name (e.g., #general, #sales)"
    },
    "description": {
      "type": "string",
      "description": "Channel description"
    },
    "created_by": {
      "type": "string",
      "description": "Sales member ID who created the channel"
    },
    "is_private": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is a private channel"
    },
    "members": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of sales member IDs in this channel"
    },
    "is_cross_app": {
      "type": "boolean",
      "default": false,
      "description": "Whether this channel bridges Estate Media and Arriv One"
    },
    "cross_app_channel_id": {
      "type": "string",
      "description": "Deterministic cross-app DM channel ID (cross_app_dm:<sorted emails>)"
    },
    "participant_emails": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Email addresses of all participants in this cross-app channel (for same-company verification)"
    }
  },
  "required": [
    "name",
    "created_by"
  ]
}