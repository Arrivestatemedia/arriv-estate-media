{
  "name": "HireJob",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Job title"
    },
    "department": {
      "type": "string",
      "description": "Department or team"
    },
    "description": {
      "type": "string",
      "description": "Full job description summary"
    },
    "responsibilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Key responsibilities"
    },
    "required_qualifications": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "preferred_qualifications": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "experience_requirements": {
      "type": "string"
    },
    "performance_expectations": {
      "type": "string"
    },
    "compensation": {
      "type": "string"
    },
    "work_schedule": {
      "type": "string"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "url",
        "text",
        "file",
        "auto"
      ],
      "description": "How the job description was provided"
    },
    "source_url": {
      "type": "string"
    },
    "source_application_position": {
      "type": "string",
      "enum": [
        "media_specialist",
        "sales_growth_advisor"
      ],
      "description": "If auto-created from the application system, the position this job was created for"
    },
    "role_success_profile": {
      "type": "object",
      "description": "AI-generated role success profile"
    },
    "role_profile_approved": {
      "type": "boolean",
      "default": false
    },
    "scorecard_template": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string"
          },
          "competency": {
            "type": "string"
          },
          "explanation": {
            "type": "string"
          }
        }
      },
      "description": "Parsed questionnaire questions used as interview scorecard template"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "open",
        "closed",
        "filled"
      ],
      "default": "draft"
    },
    "created_by_name": {
      "type": "string"
    }
  },
  "required": [
    "title"
  ]
}