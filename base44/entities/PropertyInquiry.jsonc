{
  "name": "PropertyInquiry",
  "type": "object",
  "properties": {
    "inquiry_id": {
      "type": "string",
      "description": "Stable inquiry ID (inq_...)"
    },
    "listing_id": {
      "type": "string",
      "description": "PropertyListing the inquiry was submitted from"
    },
    "public_slug": {
      "type": "string",
      "description": "Property page slug the visitor was on"
    },
    "property_reference": {
      "type": "string",
      "description": "Human-readable property reference shown to the visitor and included in the routing payload"
    },
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "consent_privacy": {
      "type": "boolean",
      "default": false,
      "description": "Visitor accepted the privacy disclosure and consented to being contacted about this property"
    },
    "consent_text_snapshot": {
      "type": "string",
      "description": "Immutable snapshot of the privacy/consent wording presented at submission"
    },
    "consent_at": {
      "type": "string",
      "format": "date-time"
    },
    "privacy_disclosures": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Disclosures shown with the form (Fair Housing notice, no-representation notice, inquiry routing notice)"
    },
    "source": {
      "type": "string",
      "default": "property_page",
      "description": "Where the inquiry originated"
    },
    "channel": {
      "type": "string",
      "enum": [
        "paid",
        "social",
        "organic",
        "referral",
        "internal",
        "direct"
      ],
      "description": "How the visitor reached the property page, derived from campaign parameters and the referrer at submission time"
    },
    "utm_source": {
      "type": "string"
    },
    "utm_medium": {
      "type": "string"
    },
    "utm_campaign": {
      "type": "string"
    },
    "utm_content": {
      "type": "string"
    },
    "utm_term": {
      "type": "string"
    },
    "referrer_host": {
      "type": "string",
      "description": "Hostname only of the referring page. A full referring URL is never stored, so a query string that may carry personal data is never retained."
    },
    "landing_page": {
      "type": "string",
      "description": "Path (no query string) of the page the inquiry was submitted from"
    },
    "ip_hash": {
      "type": "string",
      "description": "Salted hash of the submitting IP address. Personal data is never stored raw; used only for rate limiting and abuse review."
    },
    "user_agent_hash": {
      "type": "string",
      "description": "Salted hash of the submitting user agent"
    },
    "spam_score": {
      "type": "number",
      "default": 0,
      "description": "Heuristic spam score at submission"
    },
    "spam_flags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Machine-readable spam signals (honeypot tripped, link count, repeated submissions, disposable domain)"
    },
    "status": {
      "type": "string",
      "enum": [
        "received",
        "routed",
        "review",
        "rejected_spam",
        "closed"
      ],
      "default": "received"
    },
    "routed_to_email": {
      "type": "string",
      "description": "The authorized listing contact this inquiry was routed to. Never routed anywhere else."
    },
    "routed_at": {
      "type": "string",
      "format": "date-time"
    },
    "notification_status": {
      "type": "string",
      "enum": [
        "recorded",
        "pending_agent_delivery",
        "retrying",
        "delivered",
        "failed"
      ],
      "default": "pending_agent_delivery",
      "description": "Delivery state of the agent notification. The inquiry record itself is written before any send is attempted, so a delivery failure never loses the lead."
    },
    "delivery_channel": {
      "type": "string",
      "default": "email",
      "description": "How the agent was notified"
    },
    "delivery_attempts": {
      "type": "integer",
      "default": 0,
      "description": "Number of send attempts made for this inquiry"
    },
    "last_delivery_attempt_at": {
      "type": "string",
      "format": "date-time"
    },
    "next_delivery_attempt_at": {
      "type": "string",
      "format": "date-time",
      "description": "Earliest time the retry sweep may try again. Empty once delivered or terminally failed."
    },
    "delivered_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the email provider accepted the agent notification and returned a message receipt"
    },
    "delivery_message_id": {
      "type": "string",
      "description": "Provider receipt for the delivered notification"
    },
    "delivery_error": {
      "type": "string",
      "description": "Plain-language reason the most recent send attempt did not succeed"
    },
    "admin_alerted_at": {
      "type": "string",
      "format": "date-time",
      "description": "When administrators were last emailed that this lead could not be delivered, so a stuck lead is never silent"
    },
    "closed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the listing contact marked the inquiry handled"
    },
    "closed_by": {
      "type": "string"
    },
    "lead_sharing_status": {
      "type": "string",
      "enum": [
        "not_shared",
        "pending_approval",
        "shared"
      ],
      "default": "not_shared",
      "description": "Cross-app lead sharing state. Deliberately not_shared \u2014 Arriv One lead integration requires explicit approval before activation."
    },
    "arriv_one_lead_id": {
      "type": "string",
      "description": "Reserved for the future Arriv One lead identifier. Empty until lead sharing is explicitly approved and activated."
    },
    "certification_mode": {
      "type": "boolean",
      "default": false,
      "description": "True for synthetic certification inquiries. Excluded from production reporting and never emailed."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "inquiry_id",
    "listing_id",
    "name",
    "email",
    "consent_privacy"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}