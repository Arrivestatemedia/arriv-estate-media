{
  "name": "RecruitingProspect",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Prospect full name"
    },
    "title": {
      "type": "string",
      "description": "Current job title"
    },
    "company": {
      "type": "string",
      "description": "Current company"
    },
    "location": {
      "type": "string",
      "description": "Public location (city, state)"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Relevant skills"
    },
    "linkedin_url": {
      "type": "string",
      "description": "LinkedIn profile URL"
    },
    "source_url": {
      "type": "string",
      "description": "Primary source URL where found"
    },
    "source_records": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Provenance \u2014 every public source preserved, never merged away"
    },
    "contact_records": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Email/phone if publicly available"
    },
    "job_id": {
      "type": "string",
      "description": "HireJob ID this prospect is being recruited for"
    },
    "pipeline_id": {
      "type": "string",
      "description": "TalentPipeline ID if saved to a pipeline"
    },
    "search_id": {
      "type": "string",
      "description": "RecruitingSearch ID that found this prospect"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "saved",
        "dismissed",
        "approved",
        "contacted",
        "converted"
      ],
      "default": "new",
      "description": "Prospect lifecycle status"
    },
    "outreach_status": {
      "type": "string",
      "enum": [
        "not_started",
        "pending_approval",
        "approved",
        "contacted",
        "responded",
        "opted_out"
      ],
      "default": "not_started",
      "description": "Outreach workflow status"
    },
    "do_not_contact": {
      "type": "boolean",
      "default": false,
      "description": "Opt-out flag \u2014 do not contact this person"
    },
    "consent_status": {
      "type": "string",
      "default": "unknown",
      "description": "Consent state for commercial outreach"
    },
    "opt_out_date": {
      "type": "string",
      "format": "date",
      "description": "Date the prospect opted out"
    },
    "seniority_level": {
      "type": "number",
      "default": 2,
      "description": "0-5 seniority level derived from title"
    },
    "notes": {
      "type": "string",
      "description": "Internal notes about this prospect"
    },
    "outreach_message": {
      "type": "string",
      "description": "Generated outreach message"
    },
    "zip_code": {
      "type": "string",
      "description": "Zip code used in the search that found this prospect"
    },
    "radius_miles": {
      "type": "number",
      "description": "Search radius in miles"
    },
    "lat": {
      "type": "number",
      "description": "Geocoded latitude"
    },
    "lon": {
      "type": "number",
      "description": "Geocoded longitude"
    }
  },
  "required": [
    "name"
  ]
}