{
  "name": "RecruitingProspect",
  "type": "object",
  "properties": {
    "job_id": {
      "type": "string",
      "description": "HireJob ID this prospect is being recruited for (optional)"
    },
    "pipeline_id": {
      "type": "string",
      "description": "TalentPipeline ID this prospect belongs to (optional)"
    },
    "full_name": {
      "type": "string",
      "description": "Prospect full name"
    },
    "current_title": {
      "type": "string",
      "description": "Current job title"
    },
    "current_company": {
      "type": "string",
      "description": "Current company"
    },
    "public_location": {
      "type": "string",
      "description": "Public location string from web research"
    },
    "location_lat": {
      "type": "number",
      "description": "Geocoded latitude"
    },
    "location_lng": {
      "type": "number",
      "description": "Geocoded longitude"
    },
    "location_local": {
      "type": "boolean",
      "default": false,
      "description": "Whether the prospect is within the target radius"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Skills extracted from public sources"
    },
    "linkedin_url": {
      "type": "string",
      "description": "LinkedIn profile URL"
    },
    "source_url": {
      "type": "string",
      "description": "Primary source URL"
    },
    "source_records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "snippet": {
            "type": "string"
          }
        }
      },
      "description": "All public sources that provided evidence for this prospect"
    },
    "contact_records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "source_url": {
            "type": "string"
          }
        }
      },
      "description": "Public contact information found"
    },
    "seniority_level": {
      "type": "integer",
      "description": "0-5 seniority level derived from title"
    },
    "seniority_filtered": {
      "type": "boolean",
      "default": false,
      "description": "Whether this prospect was filtered out by seniority mismatch"
    },
    "location_filtered": {
      "type": "boolean",
      "default": false,
      "description": "Whether this prospect was filtered out by location"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "saved",
        "dismissed",
        "approved",
        "contacted",
        "responded",
        "converted",
        "opted_out"
      ],
      "default": "new",
      "description": "Prospect pipeline status"
    },
    "outreach_status": {
      "type": "string",
      "enum": [
        "not_started",
        "drafted",
        "approved",
        "sent",
        "replied",
        "opted_out"
      ],
      "default": "not_started"
    },
    "outreach_message": {
      "type": "string",
      "description": "Generated outreach message"
    },
    "do_not_contact": {
      "type": "boolean",
      "default": false,
      "description": "Whether the prospect has been marked do-not-contact"
    },
    "consent_status": {
      "type": "string",
      "enum": [
        "unknown",
        "consented",
        "denied",
        "opted_out"
      ],
      "default": "unknown"
    },
    "opt_out_date": {
      "type": "string",
      "format": "date-time"
    },
    "search_id": {
      "type": "string",
      "description": "RecruitingSearch ID that found this prospect"
    },
    "notes": {
      "type": "string"
    },
    "converted_candidate_id": {
      "type": "string",
      "description": "HireCandidate ID if this prospect was converted"
    }
  },
  "required": [
    "full_name"
  ]
}