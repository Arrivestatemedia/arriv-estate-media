{
  "name": "KhethaIQ Layout Sync (7am)",
  "description": "Fetches the central KhethaIQ app's full UI structure (tabs, brand, logo) and syncs it to Estate Media. Runs daily at 7am ET.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 11 * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "khethaiq_layout_sync_7am",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncKhethaIQLayout",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}