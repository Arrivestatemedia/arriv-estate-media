{
  "name": "Auto-Fund Recovery Reminders",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 9 * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Daily check for unresolved Auto-Fund payment failures \u2014 sends day 3 and day 7 reminders to customers who have not yet updated their payment method. Does not charge customers or modify wallet balances.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "autofund_recovery_reminders",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "process_recovery_reminders": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "managePaymentRecovery",
            "args": {
              "action": "process_reminders"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Process recovery reminders",
            "description": "Send day 3 and day 7 reminders for unresolved Auto-Fund payment failures"
          }
        }
      }
    ]
  }
}