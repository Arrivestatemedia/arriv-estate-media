{
  "name": "Employee Email Schedule Sweep",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": 5,
      "interval_unit": "minutes",
      "interval_anchor": "2026-11-15T02:00:00Z",
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Sends due scheduled employee emails through each employee's own connected mailbox.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "employee_email_schedule_sweep",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_due_employee_email": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "empSchedule",
            "args": {
              "action": "sweep"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Send due employee email",
            "description": "Each message goes out through its owner's mailbox"
          }
        }
      }
    ]
  }
}