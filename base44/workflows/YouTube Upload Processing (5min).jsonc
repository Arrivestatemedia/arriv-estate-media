{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 5,
      "interval_unit": "minutes",
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "youtube_upload_processing",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "process_uploads": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "processYoutubeUpload"
          },
          "then": "end",
          "x-base44": {
            "title": "Push queued videos to YouTube",
            "description": "Resumes or starts each resumable upload for a few chunks, then polls YouTube processing"
          }
        }
      }
    ]
  },
  "description": "Moves approved unbranded property videos from Google Drive to Arriv's YouTube channel in bounded steps. Each run continues from the last confirmed byte, so large videos never need one long invocation.",
  "name": "YouTube Upload Processing (5min)"
}