{
  "name": "B2B Delinquency Daily Scan",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 8 * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Daily scan of unpaid B2B invoices \u2014 sends past-due reminders, applies booking restrictions when grace periods expire, and updates organization delinquency summaries.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "b2b_delinquency_daily_scan",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "scan_delinquency": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "checkB2BDelinquency",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Scan B2B delinquency",
            "description": "Send reminders, apply restrictions, update summaries"
          }
        }
      }
    ]
  }
}